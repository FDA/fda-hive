singularity_setup () {
    local progFl="${1}"
    local workDir="${2}"
    local containerWorkDir="${3}"

    export SINGULARITY_TMPDIR="${workDir}/singularity-tmp"
    mkdir -p "${SINGULARITY_TMPDIR}"
    if [[ $? != 0 ]]; then
        echo "0,1,progError,could not create singularity tmp directory." > ${progFl}
        exit 1
    fi
    export SINGULARITY_CONTAIN=1
    export SINGULARITY_WORKDIR="${SINGULARITY_TMPDIR}"
    export SINGULARITY_PWD="${containerWorkDir}"

    SINGULARITY_BINDPATH="${workDir}:${containerWorkDir}"
    while read -r -d $'\0' linked_dir; do
        if [[ "${linked_dir}" =~ [,:] ]]; then
            echo "0,1,progError,tried to mount folder with character not supported by singularity." > ${progFl}
            exit 1
        fi
        SINGULARITY_BINDPATH="${SINGULARITY_BINDPATH},${linked_dir}"
    done < <(find "${workDir}" -type l -print0 | xargs -0 --no-run-if-empty readlink -f -z | xargs -0 --no-run-if-empty dirname -z | sort -u -z)
    export SINGULARITY_BINDPATH
}

get_capacity() {
    local svc="${1}"

    local THREADS=`qapp.os${os} -serviceGet "${svc}" capacity`
    if [[ ! -z ${THREADS} ]]; then
        rgx='^([0-9]+)'
        # remove fraction
        if [[ "${THREADS}" =~ $rgx ]]; then
            THREADS="${BASH_REMATCH[1]}"
        fi
    fi
    if [[ -z ${THREADS} || ${THREADS} -le 0 ]]; then
        THREADS=1
    fi
    echo ${THREADS}
}