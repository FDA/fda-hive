{
    "type.11": {
        "_id": "type.11",
        "_type": "type",
        "name": "user",
        "title": "user account",
        "parent": {
            "1": "type.84"
        },
        "prefetch": true,
        "fields": {
            "1.0": {
                "field_name": "email",
                "field_title": "Email address",
                "field_type": "string",
                "field_order": 3,
                "field_constraint": "regexp",
                "field_constraint_data": "/^(([^<>()[].,;:s@\"]+(.[^<>()[].,;:s@\"]+)*)|(\".+\"))@(([^<>()[].,;:s@\"]+.)+[^<>()[].,;:s@\"]{2,})$/i"
            },
            "1.2": {
                "field_name": "first_name",
                "field_title": "First name",
                "field_type": "string",
                "field_order": 1,
                "field_is_summary_fg": true,
                "field_brief": "$(v)"
            },
            "1.4": {
                "field_name": "last_name",
                "field_title": "Last name",
                "field_type": "string",
                "field_order": 2,
                "field_is_summary_fg": true,
                "field_brief": "$(v)"
            },
            "1.6": {
                "field_name": "is_email_valid_fg",
                "field_title": "Email valid",
                "field_type": "bool",
                "field_default_value": "false"
            },
            "1.7": {
                "field_name": "is_active_fg",
                "field_title": "User is activated",
                "field_type": "bool",
                "field_default_value": "false"
            },
            "1.8": {
                "field_name": "is_admin_fg",
                "field_title": "Super user",
                "field_type": "bool",
                "field_default_value": "false"
            },
            "1.9": {
                "field_name": "pswd",
                "field_title": "Password",
                "field_type": "password",
                "field_order": 4
            },
            "1.10": {
                "field_name": "pswd_reset_id",
                "field_title": "Password Reset Id",
                "field_type": "integer",
                "field_is_readonly_fg": 1,
                "field_is_optional_fg": true
            },
            "1.11": {
                "field_name": "pswd_changed",
                "field_title": "Last data of password change",
                "field_type": "datetime",
                "field_is_readonly_fg": 1,
                "field_is_optional_fg": true
            },
            "1.13": {
                "field_name": "pswd_prev_list",
                "field_title": "List of previous passwords",
                "field_type": "password",
                "field_is_readonly_fg": 1,
                "field_is_optional_fg": true,
                "field_is_multi_fg": true,
                "field_is_hidden_fg": true
            },
            "1.15": {
                "field_name": "logCount",
                "field_title": "Login count",
                "field_type": "integer",
                "field_is_readonly_fg": 1,
                "field_is_optional_fg": true
            },
            "1.16": {
                "field_name": "loginTm",
                "field_title": "Last login",
                "field_type": "datetime",
                "field_is_readonly_fg": 1,
                "field_is_optional_fg": true
            },
            "1.17": {
                "field_name": "max_sessions",
                "field_title": "Maximum Number of concurrent sessions",
                "field_type": "integer",
                "field_default_value": "1",
                "field_is_optional_fg": false,
                "field_constraint": "range",
                "field_constraint_data": "1-2147483647"
            },
            "1.19": {
                "field_name": "job_priority_offset",
                "field_title": "Jobs Priority Offset",
                "field_type": "real",
                "field_default_value": "0",
                "field_is_optional_fg": true
