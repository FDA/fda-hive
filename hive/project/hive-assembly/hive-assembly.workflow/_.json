{
	"workflows" : {
		"name" : "hive-assembly-cflow",
		"steps": [
			{
				"name": "p_alignment-sample",
				"svc": "dna-hexagon",
				"execute": [
					{
						"_id": "$newid",
						"_type": "svc-align-hexagon",

						"name": "${'hexName}",
						"alignmentEngine": 1,
						"alignParam": {
							"allowShorterEnds": 0,
							"costGapNext": -4,
							"costGapOpen": -12,
							"costMatch": 5,
							"costMismatch": -4,
							"costMismatchNext": -6,
							"isglobal": 0,
							"seed": 11
						},
						"basicAlgParam": {
							"searchRepeatsAndTrans": 0
						},
						"complexity": {
							"complexityQry": {
								"complexityEntropy": 0,
								"complexityWindow": 0,
								"maximumPercentLowQualityAllowed": 0
							},
							"complexityRef": {
								"complexityRefEntropy": 0,
								"complexityRefWindow": 0,
								"acceptNNNQuaTrheshold": 0
							}
						},
						"computeDiagonalWidth": "auto",
						"doubleHash": false,
						"doubleStagePerfect": 1,
						"fine_filters": {
							"must_have_negative": false,
							"must_cover_subsequences": false,
							"must_cover_all": true,
							"must_have_subsequences_revcomp": true
						},
						"hashCompileStp": "auto",
						"hashStp": "auto",
						"isbackward": 1,
						"isextendtails": 0,
						"isoptimize": 1,
						"keepAllMatches": 2,
						"looseExtenderMinimumLengthPercent": 66,
						"looseExtenderMismatchesPercent": 25,
						"maxExtensionGaps": 0,
						"maxHashBin": 50,
						"maxHitsPerRead": 200,
						"maxNumberQuery": "all",
						"maxSubjectBasesToCompile": 128,
						"minMatch": {
							"minMatchLen": 40,
							"minMatchUnit": 0
						},
						"mismatches": {
							"maxMissQueryPercent": 15,
							"considerGoodSubalignments": 0
						},
						"random_seed": 0,
						"readconflicts": {
							"resolveConfictsUnique": false,
							"resolveConflicts": 0,
							"resolveConflictsScore": 0
						},
						"reverseEngine": 0,
						"scissors": "hiveseq",
						"scoreFilter": "None",
						"selfQueryPosJumpInNonPerfectAlignment": 1,
						"split": "query",
						"splitList": {
							"nrepeat": 1,
							"slice": "${v_slice}",
							"splitField": "query",
							"splitSize": "${v_slice}",
							"splitType": "sequences"
						},
						"subject": [
							"${_o_reference_genome}"
						],
						"trimLowScoreEnds": {
							"trimLowScoreEndsWindow": 0
						},
						"useRedundSim": 1,
						"useScoreDensity": 0,
						"alignSelector": "svc-align-hexagon",
						"force_reindex": false,
						"query": [
							"${o_sample_reads}"
						],
						"submitter": "dna-hexagon"
					}
				]
			},
			{
				"name": "p_alignment-maff",
				"svc": "dna-alignx",
				"execute": [
					{
						"_id": "$newid",
						"_type": "svc-align-mafft",
						"name": "${'name}",

						"random_seed": 0,
						"scissors": "hiveseq",
						"split": "query",
						"splitList": {
							"nrepeat": 1,
							"slice": "${v_slice}",
							"splitSize": "${v_slice}",
							"splitType": "file"
						},
						"subject": [
							"${_o_reference_genome}"
						],
						"alignSelector": "svc-align-mafft",
						"submitter": "dna-hexagon&cmdMode=mafft"
					}
				]
			},
			{
				"name": "p_clonal-analysis",
				"svc": "dna-popul",
				"execute": [
					{
						"_id": "$newid",
						"_type": "svc-popul",
						"name": "${'clonalName}",
						"bifurcationDecisionFlag": 0,
    					"sortClones": false,
    					"pairedEnd": true,
    					"fuzzy_threshold": 50,
						"bifThreshold": 5,
						"parent_proc_ids": [
							"${_p_alignment-sample}"
						],
						"random_seed": 0,
						"scissors": "hiveseq",
						"split": "query",
						"splitList": {
							"nrepeat": 1,
							"slice": "${v_slice}",
							"splitSize": "${v_slice}",
							"splitType": "alignments"
						},
						"mutualAligmentID": [
							"${_p_alignment-maff}"
						],
						"minOverlap": 100,
						"bifMinCov": 0,
						"gap_thr": 50,
						"cloneContinuity": true,
						"reference_simil": true,
						"distance_measure": 0,
						"noise_tolerance": 3,
						"bayes": {
							"getBifurcationBayes": false,
							"getBifurcationBayesThrshld": 90
						},
						"pvalue": {
							"getBifurcationPvalue": true,
							"getBifurcationPvalueThrshld": 0.01
						},
						"treelist": {
							"treeSize": 500,
							"TreeFrameSize": 30,
							"TreeStep": 30,
							"TreeReadOverlap": 1,
							"InPopulationFrameTrees": false,
							"generateTrees": false
						},
						"qua_threshold": 0,
						"submitter": "dna-popul"
					}
				]
			},
			{
				"name": "p_alignment-sample-clonal",
				"svc": "dna-hexagon",
				"execute": [
					{
						"_id": "$newid",
						"_type": "svc-align-hexagon",

						"name": "${'hexClonalName}",
						"alignmentEngine": 1,
						"alignParam": {
							"allowShorterEnds": 0,
							"costGapNext": -4,
							"costGapOpen": -12,
							"costMatch": 5,
							"costMismatch": -4,
							"costMismatchNext": -6,
							"isglobal": 0,
							"seed": 11
						},
						"basicAlgParam": {
							"searchRepeatsAndTrans": 0
						},
						"complexity": {
							"complexityQry": {
								"complexityEntropy": 0,
								"complexityWindow": 0,
								"maximumPercentLowQualityAllowed": 0
							},
							"complexityRef": {
								"complexityRefEntropy": 0,
								"complexityRefWindow": 0,
								"acceptNNNQuaTrheshold": 0
							}
						},
						"computeDiagonalWidth": "auto",
						"doubleHash": false,
						"doubleStagePerfect": 1,
						"fine_filters": {
							"must_have_negative": false,
							"must_cover_subsequences": false,
							"must_cover_all": true,
							"must_have_subsequences_revcomp": true
						},
						"hashCompileStp": "auto",
						"hashStp": "auto",
						"isbackward": 1,
						"isextendtails": 0,
						"isoptimize": 1,
						"keepAllMatches": 2,
						"looseExtenderMinimumLengthPercent": 66,
						"looseExtenderMismatchesPercent": 25,
						"maxExtensionGaps": 0,
						"maxHashBin": 50,
						"maxHitsPerRead": 200,
						"maxNumberQuery": "all",
						"maxSubjectBasesToCompile": 128,
						"minMatch": {
							"minMatchLen": 40,
							"minMatchUnit": 0
						},
						"mismatches": {
							"maxMissQueryPercent": 15,
							"considerGoodSubalignments": 0
						},
						"random_seed": 0,
						"readconflicts": {
							"resolveConfictsUnique": false,
							"resolveConflicts": 0,
							"resolveConflictsScore": 0
						},
						"reverseEngine": 0,
						"scissors": "hiveseq",
						"scoreFilter": "None",
						"selfQueryPosJumpInNonPerfectAlignment": 1,
						"split": "query",
						"splitList": {
							"nrepeat": 1,
							"slice": "${v_slice}",
							"splitField": "query",
							"splitSize": "${v_slice}",
							"splitType": "sequences"
						},
						"subject": [
							"${_o_clones}"
						],
						"trimLowScoreEnds": {
							"trimLowScoreEndsWindow": 0
						},
						"useRedundSim": 1,
						"useScoreDensity": 0,
						"alignSelector": "svc-align-hexagon",
						"force_reindex": false,
						"query": [
							"${o_sample_reads}"
						],
						"submitter": "dna-hexagon"
					}
				]
			},
			{
				"name": "p_hepta-profiler",
				"svc": "dna-heptagon",
				"execute": [
					{
						"_id": "$newid",
						"_type": "svc-profiler-heptagon",
						"name": "${'heptClonalName}",

						"collapseRpts": true,
						"countAAs": 0,
						"cutEnds": "do not cut",
						"directionalityInfo": false,
						"disbalanceFR": "0",
						"entrCutoff": "-1",
						"filterZeros": 0,
						"generateIon": 0,
						"histograms": 1,
						"lenPercCutoff": "no cutoff",
						"maxLowQua": "no cutoff",
						"maxMissmatchPercCutoff": "0",
						"maxRptIns": "0",
						"minCover": "1",
						"minImportantEntropy": 0,
						"noise": {
							"noiseFilterParams": "none",
							"noiseProfileMax": 0.01,
							"noiseProfileResolution": 0.0001
						},
						"parent_proc_ids": [
							"${_p_alignment-sample-clonal}"
						],
						"random_seed": 0,
						"scissors": "hiveseq",
						"SEARCHFORREPEATS": 0,
						"snpCompare": "1",
						"split": "query",
						"splitList": {
							"nrepeat": 1,
							"slice": 200000,
							"splitField": "parent_proc_ids",
							"splitSize": 100000,
							"splitType": "alignments"
						},
						"supportedDeletions": true,
						"thrSNP": {
							"minFreqIgnoreSNP": 0,
							"minFreqPercent": 0
						},
						"useQuaFilter": 0,
						"aaThreshold": 0.001,
						"submitter": "dna-heptagon"
					}
				]
			}
		]
	}
}
					
