                "field_title": "Source of active sites",
                "field_type": "string",
                "field_parent": "functionalSites",
                "field_default_value": "CDD,UniProt",
                "field_is_optional_fg": true,
                "field_constraint_data": "CDD|UniProt"
            },
            "1.2": {
                "field_name": "analysis",
