{
    "type.24": {
        "_id": "type.24",
        "_type": "type",
        "name": "svc-dmSnvDis",
        "title": "nsSNVs Distribution Analysis",
        "description": "SNVDis returns the distribution of nsSNVs across the human proteome or in a set of human proteins uploaded by the user. Follow-up analysis can be performed to ascertain how these nsSNVs are distributed in the functional sites of proteins (active site, binding site, N-linked glycosylation site, etc.), domains and pathways",
        "parent": {
            "1": "type.331"
        },
        "prefetch": true,
