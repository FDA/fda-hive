{
    "400": {
        "_id": "$type.gdc_diagnosis",
        "_type": "type",
        "name": "gdc_diagnosis",
        "title": "Diagnosis",
        "fields": {
            "1.0": {
                "field_name": "icd_10_code",
                "field_title": "ICD-10 code",
                "field_type": "string",
                "field_order": 1,
                "field_is_multi_fg": true,
                "field_constraint": "choice",
                "field_constraint_data": "Glioblastoma|Glioblastoma multiforme|Glioblastoma with sarcomatous component|Glioblastoma, IDH wildtype|Glioblastoma, IDH-mutant|Unknown|Not Reported"
            },
            "1.2": {
                "field_name": "age_at_diagnosis",
                "field_title": "Patient Age at Diagnosis",
                "field_type": "integer",
                "field_order": 2,
                "field_is_optional_fg": true,
                "field_description": "Age at the time of diagnosis expressed in number of days since birth."
            },
            "1.4": {
                "field_name": "tissue_or_organ_of_origin",
                "field_title": "Tissue or organ of origin",
                "field_type": "string",
                "field_order": 3,
                "field_is_multi_fg": true,
                "field_constraint_data": "C71.0///Malignant neoplasm of cerebrum, except lobes and ventricles|C71.1///Malignant neoplasm of frontal lobe|C71.2///Malignant neoplasm of temporal lobe|C71.3///Malignant neoplasm of parietal lobe|C71.4///Malignant neoplasm of occipital lobe|C71.5///Malignant neoplasm of cerebral ventricle|C71.6///Malignant neoplasm of cerebellum|C71.7///Malignant neoplasm of brain stem|C71.8///Malignant neoplasm of overlapping sites of brain|C71.9///Malignant neoplasm of brain, unspecified",
                "field_description": "The text term used to describe the anatomic site of origin, of the patient's malignant disease, as described by the World Health Organization's (WHO) International Classification of Diseases for Oncology (ICD-O)."
            },
            "1.5": {
                "field_name": "classification_of_tumor",
                "field_title": "Tumor Type",
                "field_type": "string",
                "field_order": 4,
                "field_constraint_data": "metastasis|other|Premalignant|primary|Progression|recurrence|Unknown|not reported|Not Allowed To Collect",
                "field_description": "Text that describes the kind of disease present in the tumor specimen as related to a specific timepoint."
            },
            "1.6": {
                "field_name": "who_cns_grade",
                "field_title": "WHO grade",
                "field_type": "string",
                "field_order": 5,
                "field_is_optional_fg": true,
                "field_constraint_data": "Grade I|Grade II|Grade III|Grade IV|Grade Not Assigned|Unknown|Not Reported"
            },
            "1.7": {
                "field_name": "year_of_diagnosis",
                "field_title": "Year of initial pathologic diagnosis",
                "field_type": "integer",
                "field_order": 6,
                "field_is_optional_fg": true,
                "field_description": "Numeric value to represent the year of an individual's initial pathologic diagnosis of cancer."
            },
            "1.8": {
                "field_name": "primary_diagnosis",
                "field_title": "Primary diagnosis",
                "field_type": "string",
                "field_order": 7,
                "field_is_multi_fg": true,
                "field_constraint": "choice",
                "field_constraint_data": "Glioblastoma|Glioblastoma multiforme|Glioblastoma with sarcomatous component|Glioblastoma, IDH wildtype|Glioblastoma, IDH-mutant|Unknown|Not Reported",
                "field_description": "Text term used to describe the patient's histologic diagnosis, as described by the World Health Organization's (WHO) International Classification of Diseases for Oncology (ICD-O)."
            },
            "1.9": {
                "field_name": "site_of_resection_or_biopsy",
                "field_title": "Site of resection or biopsy",
                "field_type": "string",
                "field_order": 8,
                "field_is_optional_fg": true,
                "field_is_multi_fg": true,
                "field_constraint_data": "Brain stem|Brain, NOS|Cerebellum, NOS|Cerebrum|Choroid|Endocrine gland, NOS|Frontal lobe|Parietal lobe|Pineal gland|Pituitary gland|Occipital lobe|Temporal lobe|Ventricle, NOS|Unknown|Not Reported",
                "field_description": "The text term used to describe the anatomic site of origin, of the patient's malignant disease, as described by the World Health Organization's (WHO) International Classification of Diseases for Oncology (ICD-O)."
            },
            "1.10": {
                "field_name": "first_symptom_prior_to_diagnosis",
                "field_title": "Patient's first symptom related to disease",
                "field_type": "string",
                "field_order": 9,
                "field_is_optional_fg": true,
                "field_is_multi_fg": true,
                "field_constraint_data": "Altered Mental Status|Headaches|Motor or Movement Changes|Seizures|Sensory Changes|Visual Changes|Unknown|Not Reported",
                "field_description": "Text term used to describe the patient's first symptom experienced prior to diagnosis and thought to be related to the disease."
            },
            "1.11": {
                "field_name": "days_to_last_known_disease_status",
                "field_title": "Days to Last Known Disease Status",
                "field_type": "integer",
                "field_order": 12,
                "field_is_optional_fg": true,
                "field_description": "Time interval from the date of last follow up to the date of initial pathologic diagnosis, represented as a calculated number of days."
            },
            "1.12": {
                "field_name": "days_to_recurrence",
                "field_title": "Days to recurrence",
                "field_type": "integer",
                "field_order": 13,
                "field_is_optional_fg": true,
                "field_description": "Number of days between the date used for index and the date the patient's disease recurred."
            },
            "1.13": {
                "field_name": "days_to_last_follow_up",
                "field_title": "Days to Last Followup",
                "field_type": "integer",
                "field_order": 14,
                "field_is_optional_fg": true,
                "field_description": "Time interval from the date of last follow up to the date of initial pathologic diagnosis, represented as a calculated number of days."
            },
            "1.14": {
                "field_name": "days_to_diagnosis",
                "field_title": "Days to diagnosis",
                "field_type": "integer",
                "field_order": 15,
                "field_is_optional_fg": true,
                "field_description": "Number of days between the date used for index and the date the patient was diagnosed with the malignant disease."
            },
            "1.15": {
                "field_name": "days_to_best_overall_response",
                "field_title": "Days to best overall response",
                "field_type": "integer",
                "field_order": 16,
                "field_is_optional_fg": true,
                "field_description": "Number of days between the date used for index and the date of the patient was thought to have the best overall response to their disease."
            },
            "1.16": {
                "field_name": "best_overall_response",
                "field_title": "Best Response",
                "field_type": "string",
                "field_order": 17,
                "field_is_optional_fg": true,
                "field_is_multi_fg": true,
                "field_constraint_data": "AJ-Adjuvant Therapy|CPD-Clinical Progression|CR-Complete Response|CRU-Complete Response Unconfirmed|DU-Disease Unchanged|IMR-Immunoresponse|IPD-Immunoprogression|MR-Minimal/Marginal Response|MX-Mixed Response|Non-CR/Non-PD-Non-CR/Non-PD|NPB-No Palliative Benefit|NR-No Response|PA-Palliative Therapy|PB-Palliative Benefit|PD-Progressive Disease|PPD-Pseudoprogression|PR-Partial Response|PSR-Pseudoresponse|RD-Responsive Disease|RP-Response|RPD-Radiographic Progressive Disease|sCR-Stringent Complete Response|SD-Stable Disease|SPD-Surgical Progression|TE-Too Early|VGPR-Very Good Partial Response",
                "field_description": "The best improvement achieved throughout the entire course of protocol treatment."
            },
            "1.17": {
                "field_name": "progression_or_recurrence",
                "field_title": "Progression or Recurrence",
                "field_type": "string",
                "field_order": 18,
                "field_is_optional_fg": true,
                "field_constraint_data": "yes|no|unknown|not reported|Not Allowed To Collect",
                "field_description": "Yes/No/Unknown indicator to identify whether a patient has had a new tumor event after initial treatment."
            },
            "1.18": {
                "field_name": "last_known_disease_status",
                "field_title": "Last known disease status",
                "field_type": "string",
                "field_order": 19,
                "field_constraint_data": "Distant met recurrence/progression|Loco-regional recurrence/progression|Biochemical evidence of disease without structural correlate|Tumor free|Unknown tumor status|With tumor|not reported|Not Allowed To Collect",
                "field_description": "Text term that describes the last known state or condition of an individual's neoplasm."
            },
            "1.19": {
                "field_name": "method_of_diagnosis",
                "field_title": "Method of diagnosis",
                "field_type": "string",
                "field_order": 10,
                "field_is_optional_fg": true,
                "field_is_multi_fg": true,
                "field_constraint_data": "Autopsy|Biopsy|Cytology|Debulking|Diagnostic Imaging|Enucleation|Excisional Biopsy|Fine Needle Aspiration|Imaging|Incisional Biopsy|Other|Physical Exam|Pathologic Review|Surgical Resection|Unknown|Not Reported",
                "field_description": "Text term used to describe the method used to confirm the patients malignant diagnosis."
            },
            "1.20": {
                "field_name": "pregnant_at_diagnosis",
                "field_title": "Pregnant at diagnosis",
                "field_type": "string",
                "field_order": 11,
                "field_is_optional_fg": true,
                "field_constraint_data": "Yes|No|Unknown|Not Reported",
                "field_description": "The text term used to indicate whether the patient was pregnant at the time they were diagnosed."
            },
            "1.21": {
                "field_name": "prior_treatment",
                "field_title": "Prior treatment",
                "field_type": "string",
                "field_order": 20,
                "field_is_optional_fg": true,
                "field_constraint_data": "Yes|No|Unknown|Not Reported|Not Allowed To Collect",
                "field_description": "A yes/no/unknown/not applicable indicator related to the administration of therapeutic agents received before the body specimen was collected."
            },
            "1.22": {
                "field_name": "prior_malignancy",
                "field_title": "Prior malignancy",
                "field_type": "string",
                "field_order": 21,
                "field_is_optional_fg": true,
                "field_constraint_data": "yes|no|unknown|not reported|Not Allowed To Collect",
                "field_description": "The yes/no/unknown indicator used to describe the patient's history of prior cancer diagnosis."
            },
            "1.23": {
                "field_name": "residual_disease",
                "field_title": "Margins of surgical resection",
                "field_type": "string",
                "field_order": 22,
                "field_is_optional_fg": true,
                "field_constraint_data": "R0///All Margins Pathologically Negative|R1///Microscopically Positive Margins or Microscopic Residual Disease|R2///Macroscopically Positive Margins or Gross Residual Disease|RX///Presence of Residual Disease Cannot Be Assessed|Unknown|Not Reported",
                "field_description": "Text terms to describe the status of a tissue margin following surgical resection."
            },
            "1.24": {
                "field_name": "synchronous_malignancy",
                "field_title": "Synchronous malignancy",
                "field_type": "string",
                "field_order": 23,
                "field_is_optional_fg": true,
                "field_constraint_data": "Yes|No|Unknown|Not Reported",
                "field_description": "A yes/no/unknown indicator used to describe whether the patient had an additional malignant diagnosis at the same time the tumor used for sequencing was diagnosed. If both tumors were sequenced, both tumors would have synchronous malignancies."
            },
            "1.25": {
                "field_name": "tumor_focality",
                "field_title": "Tumor Focality",
                "field_type": "string",
                "field_order": 24,
                "field_is_optional_fg": true,
                "field_constraint_data": "Multifocal|Unifocal|Unknown|Not Reported",
                "field_description": "The text term used to describe whether the patient's disease originated in a single location or multiple locations."
            },
            "1.26": {
                "field_name": "tumor_grade",
                "field_title": "Tumor grade",
                "field_type": "string",
                "field_order": 25,
                "field_is_optional_fg": true,
                "field_constraint_data": "G1|G2|G3|G4|GX|GB|High Grade|Intermediate Grade|Low Grade|Unknown|Not Reported",
                "field_description": "Numeric value to express the degree of abnormality of cancer cells, a measure of differentiation and aggressiveness."
            },
            "1.28": {
                "field_name": "tumor_regression_grade",
                "field_title": "Tumor regression grade",
                "field_type": "string",
                "field_order": 27,
                "field_is_optional_fg": true,
                "field_constraint_data": "0|1|2|3|Unknown",
                "field_description": "A numeric value used to measure therapeutic response of the primary tumor and predict patient outcomes based on a three-point tumor regression grading system."
            },
            "1.31": {
                "field_name": "supratentorial_localization",
                "field_title": "Supratentorial Localization",
                "field_type": "string",
                "field_order": 30,
                "field_is_optional_fg": true,
                "field_constraint_data": "Cerebral Cortex|Deep Gray (e.g. Basal Ganglia, Thalamus)|Frontal lobe|Occipital lobe|Parietal lobe|Temporal lobe|White Matter|Unknown|Not Reported",
                "field_description": "Text term to specify the location of the supratentorial tumor."
            },
            "1.33": {
                "field_name": "margin_distance",
                "field_title": "Distance of Closest Surgical Margin",
                "field_type": "string",
                "field_order": 32,
                "field_is_optional_fg": true,
                "field_description": "The distance of the closest surgical margin from tumor after surgical resection of the tumor. The closest distance between a tumor and its resection margin has prognostic significance."
            },
