{
    "334": {
        "_id": "$type.ci3_demographics",
        "_type": "type",
        "name": "ci3_demographics",
        "title": "Demographics",
        "description": "a",
        "fields": {
            "1.1": {
                "field_name": "contact_email",
                "field_title": "Contact email",
                "field_type": "string",
                "field_order": 1,
                "field_is_optional_fg": true,
                "field_constraint_description": "email"
            },
            "1.2": {
                "field_name": "contact_phone",
                "field_title": "Contact phone",
                "field_type": "string",
                "field_order": 2,
                "field_is_optional_fg": true,
                "field_constraint_description": "phone"
            },
            "1.3": {
                "field_name": "date_of_birth",
                "field_title": "Date of Birth (mm/dd/yy)",
                "field_type": "date",
                "field_order": 3
            },
            "1.4": {
                "field_name": "sex_at_birth",
                "field_title": "Sex at birth",
                "field_type": "string",
                "field_order": 4,
                "field_constraint_data": "Female|Male"
            },
            "1.5": {
                "field_name": "ethnicity",
                "field_title": "Ethnicity",
                "field_type": "string",
                "field_order": 5,
                "field_is_optional_fg": true,
                "field_constraint_description": "description"
            },
            "1.6": {
                "field_name": "hispanic",
                "field_title": "Hispanic",
                "field_type": "bool",
                "field_order": 6,
                "field_is_optional_fg": true
            },
            "1.7": {
                "field_name": "race",
                "field_title": "Race (Patient Self-Reported, captured by Nurse/Personnel)",
                "field_type": "string",
                "field_order": 7,
                "field_is_optional_fg": true,
                "field_constraint_data": "American Indian/Alaska Native|Asian|Black/AA|Native Hawaiian/Pacific Islander|White|Other"
            },
            "1.8": {
                "field_name": "height",
                "field_title": "Height",
                "field_type": "obj",
                "field_order": 8,
                "field_is_optional_fg": true,
                "field_constraint_description": "height"
            },
            "1.9": {
                "field_name": "height_feet",
                "field_title": "Feet",
                "field_type": "integer",
                "field_parent": "height",
                "field_order": 8.1
            },
            "1.10": {
                "field_name": "height_inches",
                "field_title": "Inches",
                "field_type": "real",
                "field_parent": "height",
                "field_order": 8.2
            },
            "1.11": {
                "field_name": "height_cm",
                "field_title": "cm",
                "field_type": "real",
                "field_parent": "height",
                "field_order": 8.3
            },
            "1.12": {
                "field_name": "height_unit",
                "field_title": "Unit",
                "field_type": "string",
                "field_parent": "height",
                "field_order": 8.4,
                "field_constraint_data": "Feet/Inches|cm"
            },
            "1.13": {
                "field_name": "weight",
                "field_title": "Weight",
                "field_type": "obj",
                "field_order": 9,
                "field_is_optional_fg": true,
                "field_constraint_description": "unit"
            },
            "1.14": {
                "field_name": "weight_value",
                "field_title": "Value",
                "field_type": "real",
                "field_parent": "weight",
                "field_order": 9.1
            },
            "1.15": {
                "field_name": "weight_unit",
                "field_title": "Unit",
                "field_type": "string",
                "field_parent": "weight",
                "field_order": 9.2,
                "field_constraint_data": "1///kg|2.205///LB"
            },
            "1.16": {
                "field_name": "bmi",
                "field_title": "BMI (kg/m2) - continuous",
                "field_type": "real",
                "field_order": 10,
                "field_constraint_data": "if($(weight_unit)=='1'&&'$(height_cm)'!=''&&'$(weight_value)'!=''){value_fg=Math.round(((parseFloat($(weight_value))*10000)/(parseFloat($(height_cm))*parseFloat($(height_cm)))+Number.EPSILON)*100)/100;}else if('$(height_cm)'!=''&&'$(weight_value)'!=''){value_fg=Math.round((parseFloat($(weight_value))*4535.92/(parseFloat($(height_cm))*parseFloat($(height_cm)))+Number.EPSILON)*100)/100;}"
            }
        },
        "parent": {
            "3": "$type.ci3_shared"
        },
        "_perm": [
            {
                "party": "/system/",
                "act": {
                    "browse": true,
                    "read": true,
                    "write": true,
                    "exec": true,
                    "del": true,
                    "admin": true,
                    "share": true,
                    "download": true
                },
                "_infect": {
                    "party": [ "member" ]
                }
            },
            {
                "party": "/everyone/users/",
                "act": {
                    "browse": true,
                    "read": true
                },
                "_infect": {
                    "party": [ "member" ]
                }
            }
        ]
    }
}
