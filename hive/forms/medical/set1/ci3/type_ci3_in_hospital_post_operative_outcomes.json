{
    "343": {
        "_id": "$type.ci3_in_hospital_post_operative_outcomes",
        "_type": "type",
        "name": "ci3_in_hospital_post_operative_outcomes",
        "title": "In-hospital Post-operative Outcomes",
        "fields": {
            "1.1": {
                "field_name": "height",
                "field_title": "Height",
                "field_type": "obj",
                "field_order": 1,
                "field_constraint_description": "height"
            },
            "1.2": {
                "field_name": "height_feet",
                "field_title": "Feet",
                "field_type": "integer",
                "field_parent": "height",
                "field_order": 1.1
            },
            "1.3": {
                "field_name": "height_inches",
                "field_title": "Inches",
                "field_type": "real",
                "field_parent": "height",
                "field_order": 1.2
            },
            "1.4": {
                "field_name": "height_cm",
                "field_title": "cm",
                "field_type": "real",
                "field_parent": "height",
                "field_order": 1.3
            },
            "1.5": {
                "field_name": "height_unit",
                "field_title": "Unit",
                "field_type": "string",
                "field_parent": "height",
                "field_order": 1.4,
                "field_constraint_data": "Feet/Inches|cm"
            },
            "1.6": {
                "field_name": "po_weight",
                "field_title": "Weight",
                "field_type": "obj",
                "field_order": 2,
                "field_constraint_description": "unit"
            },
            "1.7": {
                "field_name": "po_weight_value",
                "field_title": "Value",
                "field_type": "real",
                "field_parent": "po_weight",
                "field_order": 2.1
            },
            "1.8": {
                "field_name": "po_weight_unit",
                "field_title": "Unit",
                "field_type": "string",
                "field_parent": "po_weight",
                "field_order": 2.2,
                "field_constraint_data": "1///kg|2.205///LB"
            },
            "1.9": {
                "field_name": "bmi",
                "field_title": "BMI",
                "field_type": "integer",
                "field_order": 3,
                "field_constraint_data": "if($(po_weight_unit)=='1'&&'$(height_cm)'!=''&&'$(po_weight_value)'!=''){value_fg=Math.round(((parseFloat($(po_weight_value))*10000)/(parseFloat($(height_cm))*parseFloat($(height_cm)))+Number.EPSILON)*100)/100;}else if('$(height_cm)'!=''&&'$(po_weight_value)'!=''){value_fg=Math.round((parseFloat($(po_weight_value))*4535.92/(parseFloat($(height_cm))*parseFloat($(height_cm)))+Number.EPSILON)*100)/100;}"
            },
            "1.10": {
                "field_name": "return_op_room",
                "field_title": "Return to the operating room",
                "field_type": "bool",
                "field_order": 4
            },
            "1.11": {
                "field_name": "in_hospital_major_complications",
                "field_title": "In-hospital major complications",
                "field_type": "string",
                "field_order": 5,
                "field_is_multi_fg": true,
                "field_constraint_data": "intraabdominal infections|intestinal perforation/leak|myocardial infarction|stroke|pneumonia|DVT/PA|Sepsis|Clavien Dindo|Death"
            },
            "1.12": {
                "field_name": "post_procedure_days",
                "field_title": "Post-procedure Length of stay (days)",
                "field_type": "integer",
                "field_order": 6,
                "field_constraint_data": "var date1='$(date_data_entry)';var date2='$(date_of_visit)';value_fg=(date1.length>0&&date2.length>0)?(((new Date(date1)).getTime()) - ((new Date(date2)).getTime()))/(1000*60*60*24):'';"
            },
            "1.13": {
                "field_name": "post_procedural_antibiotics_used",
                "field_title": "Post-procedural antibiotics used for >24h?",
                "field_type": "bool",
                "field_order": 7
            },
            "1.14": {
                "field_name": "subtitle_1",
                "field_title": "1-month Post-operative Outcomes",
                "field_type": "string",
                "field_order": 8,
                "field_is_hidden_fg": true,
                "field_constraint_description": "subtitle"
            },
            "1.15": {
                "field_name": "date",
                "field_title": "Date",
                "field_type": "date",
                "field_order": 9,
                "field_is_hidden_fg": true
            },
            "1.16": {
                "field_name": "follow_up_duration",
                "field_title": "Follow-up duration (days)",
                "field_type": "integer",
                "field_order": 10,
                "field_is_hidden_fg": true
            },
            "1.17": {
                "field_name": "one_month_in_hospital_major_complications",
                "field_title": "In-hospital major complications",
                "field_type": "string",
                "field_order": 11,
                "field_is_hidden_fg": true,
                "field_constraint_data": "intraabdominal infections|intestinal perforation/leak|myocardial infarction|stroke|pneumonia|DVT/PA|Sepsis|Death"
            },
            "1.18": {
                "field_name": "one_month_post_procedure_days",
                "field_title": "Post-procedure Length of stay (days)",
                "field_type": "integer",
                "field_order": 12,
                "field_is_hidden_fg": true
            },
            "1.19": {
                "field_name": "recurrence_small_bowel_obstruction",
                "field_title": "Recurrence of small bowel obstruction (SBO)",
                "field_type": "bool",
                "field_order": 13,
                "field_is_hidden_fg": true
            },
            "1.20": {
                "field_name": "obj",
                "field_type": "string",
                "field_order": 14,
                "field_is_hidden_fg": true,
                "field_constraint": "type"
            },
            "1.21": {
                "field_name": "clavien_dindo",
                "field_title": "Clavien Dindo",
                "field_type": "string",
                "field_order": 5.5,
                "field_constraint_data": "Grade I|Grade II|Grade IIIa|Grade IIIb|Grade IVa|Grade IVb|Grade V",
                "field_description": "Grade I\tAny deviation from the normal postoperative course without the need for pharmacological treatment or surgical, endoscopic and radiological interventions\r\nAllowed therapeutic regimens are: drugs as antiemetics, antipyretics, analgetics, diuretics and electrolytes and physiotherapy. This grade also includes wound infections opened at the bedside.\r\nGrade II\tRequiring pharmacological treatment with drugs other than such allowed for grade I complications.\r\nBlood transfusionsand total parenteral nutritionare also included.\r\nGrade III\r\n\r\nRequiring surgical, endoscopic or radiological intervention\r\n       - IIIa\r\n\r\nIntervention not under general anesthesia\r\n       - IIIb\r\n\r\nIntervention under general anesthesia\r\nGrade IV\r\n\r\nLife-threatening complication (including CNS complications)* requiring IC/ICU-management\r\n       - IVa\r\n\r\nsingle organ dysfunction (including dialysis)\r\n       - IVb\r\n\r\nmultiorgandysfunction\r\nGrade V\tDeath of a patient"
            }
        },
        "parent": {
            "3": "$type.ci3_shared"
        },
