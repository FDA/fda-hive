{
    "354": {
        "_id": "$type.tmj_patient_symptoms",
        "_type": "type",
        "name": "tmj_patient_symptoms",
        "title": "Patient Symptoms",
        "parent": {
            "4": "$type.tmj_questionnaires"
        },
        "fields": {
            "4.1": {
                "field_name": "reason_for_visit",
                "field_title": "What do you believe are your TMJ-related symptoms or issues?",
                "field_type": "text",
                "field_order": 1,
                "field_is_optional_fg": true
            },
            "4.2": {
                "field_name": "symptom_parent",
                "field_title": "List of Symptoms",
                "field_type": "array",
                "field_order": 2,
                "field_is_multi_fg": true,
                "field_constraint_description": "col-4"
            },
            "4.3": {
                "field_name": "symptom_onset",
                "field_title": "Did your symptoms develop gradually or suddenly?",
                "field_type": "string",
                "field_parent": "symptom_parent",
                "field_order": 2.04,
                "field_is_optional_fg": true,
                "field_is_multi_fg": false,
                "field_constraint_data": "sudden|gradual"
            },
            "4.4": {
                "field_name": "symptom_laterality",
                "field_title": "Are the symptoms on one or both sides?",
                "field_type": "string",
                "field_parent": "symptom_parent",
                "field_order": 2.05,
                "field_is_optional_fg": true,
                "field_is_multi_fg": false,
                "field_constraint_data": "right|left|both\r\n>is_shown_fg=$(symptoms_type)!=''&&$(symptoms_type)!='Mouth and Tongue'&&$(symptoms_in_head)!='Sinus headache'&&$(symptoms_in_head)!='Tension headache'&&$(symptoms_type)!='Sleep'"
            },
            "4.5": {
                "field_name": "severity_of _symptoms",
                "field_title": "On a scale of 0-10, what is the average severity of your symptoms in past 4 weeks?",
                "field_type": "integer",
                "field_parent": "symptom_parent",
                "field_order": 2.06,
                "field_is_optional_fg": true,
                "field_is_multi_fg": false,
                "field_constraint": "range",
                "field_constraint_data": "{\"range\":\"1-10\",\"step\":\"1\",\"pipStep\":\"1\"}",
                "field_constraint_description": "slider"
            },
            "4.6": {
                "field_name": "symptoms_in_mouth_and_tongue",
                "field_title": "Symptom",
                "field_type": "string",
                "field_parent": "symptom_parent",
                "field_order": 2.02,
                "field_is_optional_fg": true,
                "field_is_multi_fg": false,
                "field_constraint_data": "Difficulty opening and closing|Pain/difficulty to close mouth|Pain/difficulty to open mouth|tongue thrusting|mouth breathing|difficulty swallowing|pain while swallowing|gross motor control|fine motor control|other|Difficulty chewing|dietary restrictions related to chewing|lack of taste|distortion of taste|other\r\n>is_shown_fg=$(symptoms_type)=='Mouth and Tongue'"
            },
            "4.7": {
                "field_name": "symptoms_in_ears",
                "field_title": "Symptom",
                "field_type": "string",
                "field_parent": "symptom_parent",
                "field_order": 2.02,
                "field_is_optional_fg": true,
                "field_is_multi_fg": false,
                "field_constraint_data": "earaches|fullness or ringing in your ears|Eustachian tube dysfunction|Fluid/drainage from ear|ear tubes|other\r\n>is_shown_fg=$(symptoms_type)=='Ears'"
            },
            "4.8": {
                "field_name": "symptoms_in_jaw",
                "field_title": "Symptom",
                "field_type": "string",
                "field_parent": "symptom_parent",
                "field_order": 2.02,
                "field_is_optional_fg": true,
                "field_is_multi_fg": false,
                "field_constraint_data": "fatigue in your jaw when talking and/or chewing|stiffness in your jaw|Clicking with or without pain|popping|cracking|crepitus grating|squishy/fluid sound|squeaking (TMJ Implant patients only)|Eustachion tube dysfunction/ear clicking sounds/fullness in the ear|other\r\n>is_shown_fg=$(symptoms_type)=='Jaw'"
            },
            "4.9": {
                "field_name": "symptoms_in_head",
                "field_title": "Symptom",
                "field_type": "string",
                "field_parent": "symptom_parent",
                "field_order": 2.02,
                "field_is_optional_fg": true,
                "field_is_multi_fg": false,
                "field_constraint_data": "Cluster headache|Migraine headache|Sinus headache|Tension headache|Fogginess|other\r\n>is_shown_fg=$(symptoms_type)=='Headaches'"
            },
            "4.10": {
                "field_name": "symptoms_in_eyes",
                "field_title": "Symptom",
                "field_type": "string",
                "field_parent": "symptom_parent",
                "field_order": 2.02,
                "field_is_optional_fg": true,
                "field_is_multi_fg": false,
                "field_constraint_data": "pain behind your eye(s)|vision correction|blurry vision|other\r\n>is_shown_fg=$(symptoms_type)=='Eyes'"
            },
            "4.11": {
                "field_name": "symptom_triggers",
                "field_title": "List all of your symptom triggers",
                "field_type": "string",
                "field_parent": "symptom_parent",
                "field_order": 2.06,
                "field_is_optional_fg": true,
                "field_is_multi_fg": true,
                "field_constraint_data": "eating|yawning|crying|weather|mask wearing|poor sleep/position| prolonged sitting|talking|posture|coughing/sneezing|stress|dental xrays|other medicap procedures/testing|other"
            },
            "4.12": {
                "field_name": "symptoms_type",
                "field_title": "Select the type of symptom",
                "field_type": "string",
                "field_parent": "symptom_parent",
                "field_order": 2.01,
                "field_constraint_data": "Jaw|Mouth and Tongue|Eyes|Ears|Headaches|Sleep"
            },
            "4.13": {
                "field_name": "sleep_problem",
                "field_title": "Symptom",
                "field_type": "string",
                "field_parent": "symptom_parent",
                "field_order": 2.02,
                "field_is_optional_fg": true,
                "field_is_multi_fg": false,
                "field_constraint_data": "insomnia|obstructive sleep apnea|central sleep apnea|complex sleep apnea syndrome|other\r\n>is_shown_fg=$(symptoms_type)=='Sleep'"
            },
            "4.14": {
                "field_name": "symptoms_other",
                "field_title": "Please specify",
                "field_type": "string",
                "field_parent": "symptom_parent",
                "field_order": 2.03,
                "field_is_optional_fg": true,
                "field_constraint_data": "is_shown_fg=$(symptoms_in_mouth_and_tongue)=='other'||$(symptoms_in_ears)=='other'||$(symptoms_in_jaw)=='other'||$(symptoms_in_head)=='other'||$(symptoms_in_eyes)=='other'||$(sleep_problem)=='other'"
            }
        },
        "_perm": [
            {
                "party": "/system/",
                "act": {
                    "browse": true,
                    "read": true,
                    "write": true,
                    "exec": true,
                    "del": true,
                    "admin": true,
                    "share": true,
                    "download": true
                },
                "_infect": {
                    "party": [ "member" ]
                }
            },
            {
                "party": "/HIVE/Projects/TMJ/TMJ-Registry/",
                "act": {
                    "browse": true,
                    "read": true,
                    "write": true
                },
                "_infect": {
                    "party": [ "member" ]
                }
            },
            {
                "party": "/HIVE/Projects/TMJ/Administrators/",
                "act": {
                    "browse": true,
                    "read": true,
                    "write": true
                },
                "_infect": {
                    "party": [ "member" ]
                }
            }
        ]
    }
}
