                "field_type": "bool",
                "field_parent": "implant_list",
                "field_order": 2.2
            },
            "1.5": {
                "field_name": "implant_complication",
                "field_title": "Did you have a complication with this dental implant?",
                "field_type": "bool",
                "field_parent": "implant_list",
                "field_order": 2.3
            },
            "1.6": {
                "field_name": "failed_non_surgical_procedure",
