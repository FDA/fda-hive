                "field_type": "bool",
                "field_order": 3
            },
            "1.7": {
                "field_name": "complication_wisdom_tooth_extraction",
                "field_title": "Have you had a complication with a wisdom tooth extraction?",
                "field_type": "bool",
                "field_order": 4
            },
            "1.8": {
                "field_name": "restorations_complication",
                "field_title": "Have you had a complication with a restoration procedure?",
                "field_type": "bool",
                "field_order": 5
            }
        },
        "parent": {
            "4": "$type.tmj_questionnaires"
