                "field_name": "had_dental_implant",
                "field_title": "Have you had a dental implant?",
                "field_type": "bool",
                "field_order": 1
            },
            "1.2": {
                "field_name": "implant_list",
                "field_title": "Please list the implants",
                "field_type": "array",
                "field_order": 2,
                "field_is_multi_fg": true,
                "field_constraint_data": "{\"addButtonText\":\"Add an implant\",\"removeButtonText\":\"Remove implant\"}\r\n>is_shown_fg=$(had_dental_implant)=='true'",
                "field_constraint_description": "col-md-4"
            },
            "1.3": {
                "field_name": "implant_type",
                "field_title": "Indicate the type of dental implant",
                "field_type": "string",
                "field_parent": "implant_list",
                "field_order": 2.1
            },
            "1.4": {
                "field_name": "dental_implant_removed\t\twas_this_dental_implant_explanted/removed?",
