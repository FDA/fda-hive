{
    "355": {
        "_id": "$type.tmj_patient_therapeutics",
        "_type": "type",
        "name": "tmj_patient_therapeutics",
        "fields": {
            "1.17": {
                "field_constraint": "undefined"
            },
            "4.1": {
                "field_name": "medication_list",
                "field_title": "Medication List",
                "field_type": "array",
                "field_order": 1,
                "field_is_multi_fg": true,
                "field_constraint_data": "{\"addButtonText\":\"Add new medication\",\"removeButtonText\":\"Remove medication\"}",
                "field_constraint_description": "col-md-4",
                "field_description": "List all prescription medications, over the counter, supplements, biologics, herbals that you currently take or have been prescribed"
            },
            "4.2": {
                "field_name": "medication",
                "field_title": "Medication",
                "field_type": "string",
                "field_parent": "medication_list",
                "field_order": 1.1,
                "field_constraint_data": "Antianxiety agents | Antidepressants (SSRIs) | Tricyclic Antidepressants | Anticonvulsants (gabapentinoids) | Anti-inflammatory agents | NSAIDS | steroids | Therapeutic pain ointments/creams | Muscle relaxants/antispasmotic | Narcotics/Opioids | Hormone |Replacement Therapy/Hormonal birth control |Contraceptives | Dietary Supplement | Medical Marijuana"
            },
            "4.3": {
                "field_name": "medication_prescribed",
                "field_title": "Prescribed",
                "field_type": "bool",
                "field_parent": "medication_list",
                "field_order": 1.2
            },
            "4.4": {
                "field_name": "medication_how_used",
                "field_title": "How it is used?",
                "field_type": "string",
                "field_parent": "medication_list",
                "field_order": 1.3,
                "field_constraint_data": "taken as prescribed|taken as needed|other",
                "field_description": "For each prescription medications, over the counter, supplements, herbals, indicate how it is used."
            },
            "4.5": {
                "field_name": "medication_how_used_other",
                "field_title": "Please specify modifications or usage details",
                "field_type": "text",
                "field_parent": "medication_list",
                "field_order": 1.4,
                "field_constraint_data": "is_shown_fg=$(medication_how_used)=='other'"
            },
            "4.6": {
                "field_name": "subtitle_2",
                "field_title": "Therapeutics",
                "field_type": "string",
                "field_order": 4,
                "field_constraint_description": "subtitle"
            },
            "4.7": {
                "field_name": "chemotherapy",
                "field_title": "Have you been treated with Chemotherapy?",
                "field_type": "bool",
                "field_order": 5
            },
            "4.8": {
                "field_name": "radiation_radiotherapy",
                "field_title": "Have you been treated with Radiation/Radiotherapy?",
                "field_type": "bool",
                "field_order": 6
            },
            "4.9": {
                "field_name": "any_implantable_devices",
                "field_title": "Do you have any implantable devices?",
                "field_type": "bool",
                "field_order": 6.5
            },
            "4.10": {
                "field_name": "implantable_device_list",
                "field_title": "Implantable Device List",
                "field_type": "array",
                "field_order": 7,
                "field_is_multi_fg": true,
                "field_constraint_data": "{\"addButtonText\":\"Add new device\",\"removeButtonText\":\"Remove device\"}\r\n>is_shown_fg=$(any_implantable_devices)=='true'",
                "field_constraint_description": "col-md-6"
            },
            "4.11": {
                "field_name": "udi",
                "field_title": "Provide the UDI if it is available",
                "field_type": "string",
                "field_parent": "implantable_device_list",
                "field_order": 7.1,
                "field_is_optional_fg": true,
                "field_description": "e.g., from your implant card"
            },
            "4.12": {
                "field_name": "device_type",
                "field_title": "Provide the device type of the implant",
                "field_type": "string",
                "field_parent": "implantable_device_list",
                "field_order": 7.2,
                "field_description": "e.g., pacemaker, joint replacement (e.g., hip, knee)"
            },
            "4.13": {
                "field_name": "manufacturer",
                "field_title": "Provide the name of the manufacturer (if known)",
                "field_type": "string",
                "field_parent": "implantable_device_list",
                "field_order": 7.3,
                "field_is_optional_fg": true
            },
            "4.14": {
                "field_name": "brand_name",
                "field_title": "Provide the brand name of the implant (if known)",
                "field_type": "string",
                "field_parent": "implantable_device_list",
                "field_order": 7.4,
                "field_is_optional_fg": true
            },
            "4.15": {
                "field_name": "model",
                "field_title": "Provide the model name/number of the implant (if known)",
                "field_type": "string",
                "field_parent": "implantable_device_list",
                "field_order": 7.5,
                "field_is_optional_fg": true
            },
            "4.16": {
                "field_name": "previous_device_implant",
                "field_title": "Provide information if you have experienced improvement since TMJ implant.",
                "field_type": "text",
                "field_parent": "implantable_device_list",
                "field_order": 7.6
            },
            "4.17": {
                "field_name": "glasses_or_contacts",
                "field_title": "Do you wear eye glasses or contacts?",
                "field_type": "bool",
                "field_order": 8
            },
            "4.18": {
                "field_name": "subtitle_4",
                "field_title": "Allergies and Sensitivities",
                "field_type": "string",
                "field_order": 9,
                "field_constraint_description": "subtitle"
            },
            "4.19": {
                "field_name": "metal_alergy",
                "field_title": "Do you have an allergy or sensitivity to metal?",
                "field_type": "bool",
                "field_order": 10
            },
            "4.20": {
                "field_name": "medications_allergies",
                "field_title": "Do you have any allergies to medications?",
                "field_type": "bool",
                "field_order": 12
            },
            "4.21": {
                "field_name": "other_allergies",
                "field_title": "Do you have any of the following allergies or sensitivities?",
                "field_type": "string",
                "field_order": 13,
                "field_is_optional_fg": true,
                "field_is_multi_fg": true,
                "field_constraint_data": "animals|pollen|mold|dust mites|latex|insect stings|cockroaches,|perfumes|household chemicals|milk|eggs|fish|Crustacean shellfish|tree nuts|peanuts|wheat|soybeans|other",
                "field_constraint_description": "dropdown"
            }
        },
