{
    "184": {
        "_id": "$type.medtronic_study_exit",
        "_type": "type",
        "name": "medtronic_study_exit",
        "title": "Study Exit",
        "fields": {
            "1.2": {
                "field_name": "date_of_study_exit",
                "field_title": "What is the date of Study Exit?",
                "field_type": "date",
                "field_order": "2"
            },
            "1.3": {
                "field_name": "status_of_subject",
                "field_title": "What was the subject's status?",
                "field_type": "string",
                "field_order": "3",
                "field_constraint_data": "COMPLETED|DEATH|LOST TO FOLLOW-UP|PHYSICIAN DECISION|PROCEDURE NOT ATTEMPTED|SCREEN FAILURE|SPONSOR REQUEST|WITHDRAWAL BY SUBJECT|OTHER"
            },
            "1.4": {
                "field_name": "other_specify_status",
                "field_title": "Specify status",
                "field_type": "string",
                "field_order": "4",
                "field_is_optional_fg": true,
                "field_constraint_data": "is_shown_fg=$(status_of_subject)=='OTHER'"
            },
            "1.5": {
                "field_name": "specify_the_Document_id",
                "field_title": "If AE, specify the Document ID",
                "field_type": "string",
                "field_order": "5",
                "field_is_optional_fg": true,
                "field_constraint_data": "is_shown_fg=$(status_of_subject)=='DEATH'"
            },
            "1.6": {
                "field_name": "describe_exit_reason",
                "field_title": "Describe exit reason",
                "field_type": "string",
                "field_order": "6",
                "field_is_optional_fg": true
            },
            "1.7": {
                "field_name": "exit_related_to_the_covid_19_pandemic",
                "field_title": "Was the exit related to the COVID-19 pandemic?",
                "field_type": "string",
                "field_order": "7",
                "field_is_optional_fg": true,
                "field_constraint_data": "NO|YES"
            },
            "1.8": {
                "field_name": "subject_death",
                "field_title": "Subject Death",
                "field_type": "string",
                "field_order": "8",
                "field_is_optional_fg": true,
                "field_constraint_description": "subtitle"
            },
            "1.9": {
                "field_name": "specify_the_primary_cause_of_death",
                "field_title": "Specify the primary cause of death",
                "field_type": "string",
                "field_order": "9",
                "field_is_optional_fg": true
            },
            "1.10": {
                "field_name": "description_of_the_subject_death",
                "field_title": "Write a detailed description of the subject death including signs, symptoms and treatments immediately leading up to the death",
                "field_type": "text",
                "field_order": "10",
                "field_is_optional_fg": true
            },
            "1.11": {
                "field_name": "supporting_documentation",
                "field_title": "Supporting Documentation",
                "field_type": "string",
                "field_order": "11",
                "field_is_optional_fg": true,
                "field_constraint_description": "subtitle"
            },
            "1.12": {
                "field_name": "hospital_discharge_note",
                "field_title": "Hospital discharge note(s) and/or progress note(s) related to the death",
                "field_type": "string",
                "field_order": "12",
                "field_is_optional_fg": true,
                "field_constraint_data": "SENT|DOCUMENTATION NOT AVAILABLE"
            },
            "1.13": {
                "field_name": "death_certificate",
                "field_title": "Death Certificate",
                "field_type": "string",
                "field_order": "13",
                "field_is_optional_fg": true,
                "field_constraint_data": "SENT|DOCUMENTATION NOT AVAILABLE"
            },
            "1.14": {
                "field_name": "autopsy_report",
                "field_title": "Autopsy Report",
                "field_type": "string",
                "field_order": "14",
                "field_is_optional_fg": true,
                "field_constraint_data": "SENT|DOCUMENTATION NOT AVAILABLE"
            }
        },
        "parent": {
            "7": "$type.medtronic"
        },
        "_perm": [
            {
                "party": "/system/",
                "act": {
                    "browse": true,
                    "read": true,
                    "write": true,
                    "exec": true,
                    "del": true,
                    "admin": true,
                    "share": true,
                    "download": true
                },
                "_infect": {
                    "party": [ "member" ]
                }
            },
            {
                "party": "/everyone/users/",
                "act": {
                    "browse": true,
                    "read": true
                },
                "_infect": {
                    "party": [ "member" ]
                }
            }
        ]
    }
}
