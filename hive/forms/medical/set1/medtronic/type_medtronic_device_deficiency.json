{
    "170": {
        "_id": "$type.medtronic_device_deficiency",
        "_type": "type",
        "name": "medtronic_device_deficiency",
        "title": "Device Deficiency",
        "fields": {
            "1.2": {
                "field_name": "start_date_of_device _deficiency",
                "field_title": "Start date of device deficiency",
                "field_type": "date",
                "field_order": "2"
            },
            "1.3": {
                "field_name": "date_site_became_aware_of_deficiency",
                "field_title": "Date site became aware of deficiency",
                "field_type": "date",
                "field_order": "3"
            },
            "1.4": {
                "field_name": "device_deficiency_term",
                "field_title": "What is the device deficiency term?",
                "field_type": "string",
                "field_order": "4"
            },
            "1.5": {
                "field_name": "device_deficiency_descriptions",
                "field_title": "Device deficiency description",
                "field_type": "array",
                "field_order": "5",
                "field_is_multi_fg": true
            },
            "1.6": {
                "field_name": "could_device _eficiency_led_to_device_effect",
                "field_title": "Could device deficiency have led to a serious adverse device effect (SADE) if: a) suitable action had not been taken, b) intervention had not been made, or c) circumstances had been less fortunate?",
                "field_type": "string",
                "field_order": "6",
                "field_constraint_data": "NO|YES"
            },
            "1.7": {
                "field_name": "provide_applicable_device_identifier",
                "field_title": "Provide the applicable device identifier(s)",
                "field_type": "array",
                "field_order": "7",
                "field_is_optional_fg": true,
                "field_is_multi_fg": true
            },
            "1.8": {
                "field_name": "device_component_disposition",
                "field_title": "Device/Component Disposition",
                "field_type": "string",
                "field_parent": "provide_applicable_device_identifier",
                "field_order": "1",
                "field_is_optional_fg": true,
                "field_constraint_data": "RETURN - OPEN/USED|RETURN - UN-OPENED/EXCESS STORAGE|RETURN - EXPIRED|RETURN - DAMAGED UPON RECEIPT|RETURN - END OF STUDY|RETURN - WITH COMPLAINT|RETURN - OTHER|NOT RETURNED - DESTROYED|NOT RETURNED - OTHER|IN-USE"
            },
            "1.9": {
                "field_name": "device_type",
                "field_title": "Device Type",
                "field_type": "string",
                "field_parent": "provide_applicable_device_identifier",
                "field_order": "2",
                "field_is_optional_fg": true,
                "field_constraint_data": "ALLOGRAFT BONE CHIPS|BONE GRAFT|PEDICLE OR CORTICAL SCREWS|ROD|SET SCREW|SPINAL SYSTEM"
            },
            "1.10": {
                "field_name": "model_identifier",
                "field_title": "Model Identifier",
                "field_type": "string",
                "field_parent": "provide_applicable_device_identifier",
                "field_order": "3",
                "field_is_optional_fg": true,
                "field_constraint_data": "2.10 mg INFUSE BONE GRAFT, EXTRA SMALL|4.20 mg INFUSE BONE GRAFT, SMALL|CAPSTONE PEEK SPINAL SYSTEM|COMMUNITY TISSUE SERVICES (CTS) ALLOGRAFT BONE CHIPS|OTHER"
            },
            "1.12": {
                "field_name": "serial_number",
                "field_title": "Serial Number",
                "field_type": "string",
                "field_parent": "provide_applicable_device_identifier",
                "field_order": "4",
                "field_is_optional_fg": true
            },
            "1.13": {
                "field_name": "lot_number",
                "field_title": "Lot Number",
                "field_type": "string",
                "field_parent": "provide_applicable_device_identifier",
                "field_order": "5",
                "field_is_optional_fg": true
            },
            "1.15": {
                "field_name": "device_deficiency_description",
                "field_title": "What is the device deficiency description?",
                "field_type": "text",
                "field_parent": "device_deficiency_descriptions",
                "field_order": "1"
            }
        },
        "parent": {
            "7": "$type.medtronic"
        },
        "_perm": [
            {
                "party": "/system/",
                "act": {
                    "browse": true,
                    "read": true,
                    "write": true,
                    "exec": true,
                    "del": true,
                    "admin": true,
                    "share": true,
                    "download": true
                },
                "_infect": {
                    "party": [ "member" ]
                }
            },
            {
                "party": "/everyone/users/",
                "act": {
                    "browse": true,
                    "read": true
                },
                "_infect": {
                    "party": [ "member" ]
                }
            }
        ]
    }
}
