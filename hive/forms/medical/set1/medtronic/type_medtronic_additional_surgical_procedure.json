                "field_type": "string",
                "field_order": "9",
                "field_is_optional_fg": true,
                "field_constraint_data": "L1-L2|L2-L3|L3-L4|L4-L5|L5-S1|L5-L6|L6-S1|Other Spinal Level\n>is_shown_fg=$(additional_surgical_procedure_involve_a_spinal_level)=='YES'"
