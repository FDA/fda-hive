                "field_type": "string",
                "field_order": "6",
                "field_is_optional_fg": true,
                "field_constraint_data": "is_shown_fg=$(additional_surgical_procedure_an_elective_removal)=='YES'"
            },
            "1.9": {
                "field_name": "index_treated_level",
                "field_title": "Were the index treated level(s) fused prior to the elective removal of the fixation component of the original surgical construct?",
