                "field_order": "19",
                "field_is_optional_fg": true,
                "field_constraint_data": "is_shown_fg=$(additional_surgical_procedure_involve_an_explant_related_to_the_study_procedure)=='YES'"
            },
            "1.23": {
                "field_name": "findings_at_the_additional_surgical_procedure",
                "field_title": "Provide any findings at the additional surgical procedure",
                "field_type": "string",
                "field_order": "20",
                "field_is_optional_fg": true,
                "field_constraint_data": "is_shown_fg=$(additional_surgical_procedure_involve_an_explant_related_to_the_study_procedure)=='YES'"
            },
            "1.24": {
                "field_name": "any_biopsies_taken",
                "field_title": "Were any biopsies taken?",
                "field_type": "string",
                "field_order": "21",
                "field_is_optional_fg": true,
                "field_constraint_data": "NO|YES\n>is_shown_fg=$(additional_surgical_procedure_involve_an_explant_related_to_the_study_procedure)=='YES'"
            },
            "1.25": {
                "field_name": "explanted_devices",
                "field_title": "Explanted Devices",
                "field_type": "string",
                "field_order": "22",
                "field_is_optional_fg": true,
                "field_constraint_description": "subtitle"
            },
            "1.26": {
                "field_name": "explanted_devices",
                "field_title": "Explanted Devices",
                "field_type": "array",
                "field_order": "23",
                "field_is_optional_fg": true,
                "field_is_multi_fg": true
            },
            "1.27": {
                "field_name": "device_component_disposition",
