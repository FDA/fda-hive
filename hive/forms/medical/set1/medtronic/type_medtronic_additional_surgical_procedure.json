                "field_type": "date",
                "field_order": "2"
            },
            "1.3": {
                "field_name": "event_document_number",
                "field_title": "Event document number",
                "field_type": "array",
                "field_order": "3",
                "field_is_multi_fg": false,
                "field_is_hidden_fg": true
            },
            "1.4": {
                "field_name": "document_number",
                "field_title": "Document Number",
                "field_type": "string",
                "field_parent": "event_document_number",
                "field_order": "1",
                "field_is_optional_fg": true,
                "field_is_hidden_fg": true
            },
            "1.5": {
                "field_name": "subevent_number",
                "field_title": "Subevent number",
                "field_type": "string",
                "field_parent": "event_document_number",
                "field_order": "2",
                "field_is_optional_fg": true,
                "field_is_hidden_fg": true
            },
            "1.6": {
                "field_name": "describe_the_additional _urgical_procedure",
