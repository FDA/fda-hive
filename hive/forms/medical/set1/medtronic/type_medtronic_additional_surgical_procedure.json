                "field_constraint_data": "is_shown_fg=$(additional_surgical_procedure_related_to_a_study_procedure)=='UNLIKELY'||$(additional_surgical_procedure_related_to_a_study_procedure)=='POSSIBLE'||$(additional_surgical_procedure_related_to_a_study_procedure)=='PROBABLE'||$(additional_surgical_procedure_related_to_a_study_procedure)=='CAUSAL RELATIONSHIP'"
            },
            "1.16": {
                "field_name": "additional_surgical_procedure_related_to_the_tlif_grafting_material",
