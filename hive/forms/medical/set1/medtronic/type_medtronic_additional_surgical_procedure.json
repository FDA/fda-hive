            "1.31": {
                "field_name": "lot_number",
                "field_title": "Lot Number",
                "field_type": "string",
                "field_parent": "explanted_devices",
                "field_order": "6",
                "field_is_optional_fg": true,
                "field_is_hidden_fg": true
            },
            "1.33": {
                "field_name": "device_identifier",
                "field_title": "Device Identifier",
                "field_type": "string",
                "field_parent": "explanted_devices",
                "field_order": "4",
                "field_constraint_data": "is_shown_fg=$(model_identifier)=='OTHER'"
