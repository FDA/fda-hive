                "field_type": "string",
                "field_order": "18",
                "field_is_optional_fg": true,
                "field_constraint_data": "is_shown_fg=$(additional_surgical_procedure_involve_an_explant_related_to_the_study_procedure)=='YES'"
            },
            "1.22": {
                "field_name": "clinical_and_or_radiographic_findings",
                "field_title": "Provide any clinical and/or radiographic findings in relation to the explantation",
