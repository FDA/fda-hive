                "field_type": "string",
                "field_parent": "explanted_devices",
                "field_order": "3",
                "field_is_optional_fg": true,
                "field_constraint_data": "2.10 mg INFUSE BONE GRAFT, EXTRA SMALL|4.20 mg INFUSE BONE GRAFT, SMALL|CAPSTONE PEEK SPINAL SYSTEM|ALLOGRAFT BONE CHIPS|OTHER"
            },
            "1.30": {
                "field_name": "serial_number",
                "field_title": "Serial Number",
                "field_type": "string",
                "field_parent": "explanted_devices",
