{
    "467": {
        "_id": "$type.hep_cryovials_urine",
        "_type": "type",
        "name": "hep_cryovials_urine",
        "title": "Urine Collection Form",
        "fields": {
            "1.1": {
                "field_name": "visit",
                "field_title": "Visit",
                "field_type": "string",
                "field_order": 1,
                "field_is_hidden_fg": true,
                "field_constraint_data": "Visit 1|Visit 2"
            },
            "1.2": {
                "field_name": "sample_collected",
                "field_title": "Was sample collected?",
                "field_type": "bool",
                "field_order": 2
            },
            "1.3": {
                "field_name": "labeled",
                "field_title": "Were Tubes/Cryovials Labeled? (Subject ID (including 3 letter site code) and date)",
                "field_type": "bool",
                "field_order": 3
            },
            "1.4": {
                "field_name": "storage",
                "field_title": "Stored at -80ºC? (Collect sample in sterile specimen container, transfer 10-15 cc into cryovials,  freeze at -20ºC for 24 hours, then transfer to -80ºC until shipment. Record exact time of collection bellow (use military time).)",
                "field_type": "bool",
                "field_order": 4
            },
            "1.5": {
                "field_name": "urine_toc",
                "field_title": "Date/Time of collection",
                "field_type": "datetime",
                "field_order": 5,
                "field_constraint_data": "{\n\"startDate\":\"1900\",\n\"endDate\":\"now\"\n}"
            },
            "1.6": {
                "field_name": "urine_cm",
                "field_title": "Current Medications (For Epilepsy or Otherwise)",
                "field_type": "text",
                "field_order": 6
            },
            "1.7": {
                "field_name": "urine_ah",
                "field_title": "Alcohol history during the month",
                "field_type": "text",
                "field_order": 7
            },
            "1.8": {
                "field_name": "urine_sh",
                "field_title": "Smoking history during the previous 6 months",
                "field_type": "text",
                "field_order": 8
            },
            "1.9": {
                "field_name": "comments",
                "field_title": "Other Comments",
                "field_type": "text",
                "field_order": 9,
                "field_is_optional_fg": true
            },
            "1.10": {
                "field_name": "concurrent_illness",
                "field_title": "Has the participant had any concurrent illness (i.e. infections), recent surgeries, or other hospitalization unrelated to epilepsy?",
                "field_type": "bool",
                "field_order": 10
            },
            "1.11": {
                "field_name": "concurrent_illness_specify",
                "field_title": "If yes, please provide details",
                "field_type": "text",
                "field_order": 11,
                "field_constraint_data": "is_shown_fg=$(concurrent_illness)=='true'"
            }
        },
        "parent": {
            "3": "$type.hep"
        },
        "_perm": [
            {
                "party": "/system/",
                "act": {
                    "browse": true,
                    "read": true,
                    "write": true,
                    "exec": true,
                    "del": true,
                    "admin": true,
                    "share": true,
                    "download": true
                },
                "_infect": {
                    "party": [ "member" ]
                }
            }
        ]
    }
}
