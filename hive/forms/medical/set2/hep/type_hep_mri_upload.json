{
    "511": {
        "_id": "$type.hep_mri_upload",
        "_type": "type",
        "name": "hep_mri_upload",
        "title": "MRI Upload",
        "fields": {
            "1.1": {
                "field_name": "neuroimaging_completed",
                "field_title": "Was Neuroimaging completed?",
                "field_type": "bool",
                "field_order": 1
            },
            "1.2": {
                "field_name": "procedure_result",
                "field_title": "Please select procedure",
                "field_type": "string",
                "field_order": 2,
                "field_is_multi_fg": true,
                "field_constraint_data": "CT|MRI\n>is_shown_fg=$(neuroimaging_completed)=='true'"
            },
            "1.3": {
                "field_name": "result",
                "field_title": "Please select result",
                "field_type": "string",
                "field_order": 3,
                "field_constraint_data": "Normal|Abnormal\n>is_shown_fg=$(neuroimaging_completed)=='true'"
            },
            "1.4": {
                "field_name": "subtitle_1",
                "field_title": "Focal",
                "field_type": "string",
                "field_order": 4,
                "field_constraint_data": "is_shown_fg=$(result)=='Abnormal'&&$(neuroimaging_completed)=='true'",
                "field_constraint_description": "subtitle"
            },
            "1.5": {
                "field_name": "focal_specify_findings_mri",
                "field_title": "Specify findings on MRI",
                "field_type": "string",
                "field_order": 5,
                "field_is_optional_fg": true,
                "field_constraint_data": "is_shown_fg=$(result)=='Abnormal'&&$(neuroimaging_completed)=='true'"
            },
            "1.6": {
                "field_name": "focal_specify_findings_ct",
                "field_title": "Specify findings on CT",
                "field_type": "string",
                "field_order": 6,
                "field_is_optional_fg": true,
                "field_constraint_data": "is_shown_fg=$(result)=='Abnormal'&&$(neuroimaging_completed)=='true'"
            },
            "1.7": {
                "field_name": "subtitle_2",
                "field_title": "Diffuse",
                "field_type": "string",
                "field_order": 7,
                "field_constraint_data": "is_shown_fg=$(result)=='Abnormal'&&$(neuroimaging_completed)=='true'",
                "field_constraint_description": "subtitle"
            },
            "1.8": {
                "field_name": "focal_diffuse_findings_mri",
                "field_title": "Specify findings on MRI",
                "field_type": "string",
                "field_order": 8,
                "field_is_optional_fg": true,
                "field_constraint_data": "is_shown_fg=$(result)=='Abnormal'&&$(neuroimaging_completed)=='true'"
            },
            "1.9": {
                "field_name": "focal_diffuse_findings_ct",
                "field_title": "Specify findings on CT",
                "field_type": "string",
                "field_order": 9,
                "field_is_optional_fg": true,
                "field_constraint_data": "is_shown_fg=$(result)=='Abnormal'&&$(neuroimaging_completed)=='true'"
            },
            "1.10": {
                "field_name": "subtitle_3",
                "field_title": "Non-specific or incidental (e.g. small white matter changes, mild atrophy, arachnoid cyst)",
                "field_type": "string",
                "field_order": 10,
                "field_constraint_data": "is_shown_fg=$(result)=='Abnormal'&&$(neuroimaging_completed)=='true'",
                "field_constraint_description": "subtitle"
            },
            "1.11": {
                "field_name": "focal_incidental_findings_mri",
                "field_title": "Specify findings on MRI",
                "field_type": "string",
                "field_order": 11,
                "field_is_optional_fg": true,
                "field_constraint_data": "is_shown_fg=$(result)=='Abnormal'&&$(neuroimaging_completed)=='true'"
            },
            "1.12": {
                "field_name": "focal_incidental_findings_ct",
                "field_title": "Specify findings on CT",
                "field_type": "string",
                "field_order": 12,
                "field_is_optional_fg": true,
                "field_constraint_data": "is_shown_fg=$(result)=='Abnormal'&&$(neuroimaging_completed)=='true'"
            },
            "1.13": {
                "field_name": "neuroimaging",
                "field_title": "Was Neuroimaging uploaded?",
                "field_type": "bool",
                "field_order": 13
            },
            "1.14": {
                "field_name": "neuroimaging_date",
                "field_title": "Please enter exam date",
                "field_type": "date",
                "field_order": 14,
                "field_constraint_data": "{\n\"startDate\":\"1900\",\n\"endDate\":\"now\"\n}\n>is_shown_fg=$(neuroimaging)=='true'"
            },
            "1.15": {
                "field_name": "files",
                "field_title": "Files",
                "field_type": "file",
                "field_order": 15,
                "field_is_optional_fg": true,
                "field_is_multi_fg": true
            }
        },
        "parent": {
            "3": "$type.hep"
        },
        "_perm": [
            {
                "party": "/system/",
                "act": {
                    "browse": true,
                    "read": true,
                    "write": true,
                    "exec": true,
                    "del": true,
                    "admin": true,
                    "share": true,
                    "download": true
                },
                "_infect": {
                    "party": [ "member" ]
                }
            }
        ]
    }
}
