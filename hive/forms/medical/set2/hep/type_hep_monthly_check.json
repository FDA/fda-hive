                "field_name": "sleep_last_3_nights",
                "field_title": "Did you sleep at least 2 hours less than usual any of the last 3 nights?",
                "field_type": "bool",
                "field_order": 5.9,
                "field_constraint_data": "is_shown_fg=$(patient_contact)=='true'"
            },
