{
    "493": {
        "_id": "$type.hep_inclusion_criteria",
        "_type": "type",
        "name": "hep_inclusion_criteria",
        "title": "Inclusion/Exclusion Checklist",
        "fields": {
            "1.1": {
                "field_name": "subtitile_1",
                "field_title": "INCLUSION CRITERIA (must be YES)",
                "field_type": "string",
                "field_order": 1,
                "field_constraint_data": "is_shown_fg=$(cohort)!=''",
                "field_constraint_description": "subtitle"
            },
            "1.2": {
                "field_name": "eizures_history_epilepsy",
                "field_title": "Clinical seizure(s) and history consistent with idiopathic generalized epilepsy",
                "field_type": "bool",
                "field_order": 2,
                "field_constraint_data": "is_shown_fg=$(cohort)!=''"
            },
            "1.3": {
                "field_name": "absence_myoclonus_convulsions",
                "field_title": "The seizure types are absence, myoclonus or generalized tonic-clonic convulsions",
                "field_type": "bool",
                "field_order": 3,
                "field_constraint_data": "is_shown_fg=$(cohort)!=''"
            },
            "1.4": {
                "field_name": "seizure_prior_to_treatment",
                "field_title": "Occurrence of at least 1 seizure of any type in the 6 months prior to treatment",
                "field_type": "bool",
                "field_order": 4,
                "field_constraint_data": "is_shown_fg=$(cohort)!=''"
            },
            "1.5": {
                "field_name": "complete_medication_history",
                "field_title": "Availability of a complete medication history since initiation of treatment, including doses and date of initiation",
                "field_type": "bool",
                "field_order": 5,
                "field_constraint_data": "is_shown_fg=$(cohort)!=''"
            },
            "1.6": {
                "field_name": "a8yo_diagnosis",
                "field_title": "Age ≥8 years at time of seizure diagnosis",
                "field_type": "bool",
                "field_order": 6,
                "field_constraint_data": "is_shown_fg=$(cohort)!=''"
            },
            "1.7": {
                "field_name": "a13yo_enrollment",
                "field_title": "Age ≥13 years at time of enrollment",
                "field_type": "bool",
                "field_order": 7,
                "field_constraint_data": "is_shown_fg=$(cohort)!=''"
            },
            "1.8": {
                "field_name": "aed_treatment_12m_prior_enrollment",
                "field_title": "AED treatment (for seizure) instituted not more than 12 months prior to enrollment",
                "field_type": "bool",
                "field_order": 8,
                "field_constraint_data": "is_shown_fg=$(cohort)!=''"
            },
            "1.9": {
                "field_name": "select",
                "field_title": "Select at least one of the following:",
                "field_type": "string",
                "field_order": 9,
                "field_is_optional_fg": true,
                "field_is_multi_fg": true,
                "field_constraint_data": "GTCSs alone accompanied by generalized spike-wave consistent with IGE per adjudication review|GTCSs with a history of absence and/or myoclonus, accompanied by generalized spike-wave consistent with IGE per adjudication review|GTCSs associated with a history of absence and/or myoclonus, not accompanied by generalized spike-wave consistent with IGE per adjudication review|A clear history of absence and/or myoclonus, accompanied by generalized spike-wave consistent with IGE per adjudication review\r\n>is_shown_fg=$(cohort)!=''",
                "field_constraint_description": "checkbox"
            },
            "1.10": {
                "field_name": "exemption",
                "field_type": "string",
                "field_order": 10,
                "field_constraint_data": "is_shown_fg=count($(select))==0||$(eizures_history_epilepsy)=='false'||$(absence_myoclonus_convulsions)=='false'||$(seizure_prior_to_treatment)=='false'||$(complete_medication_history)=='false'||$(a8yo_diagnosis)=='false'||$(a13yo_enrollment)=='false'||$(aed_treatment_12m_prior_enrollment)=='false'||($(cohort)=='Cohort 3'&&$(treatment_resistant)=='false')",
                "field_constraint_description": "description",
                "field_description": "<h2 style=\"color: red;\">One or more 'No' is marked, the patient is not eligible to participate. </h2>"
            },
            "1.11": {
                "field_name": "subtitile_2",
                "field_title": "EXCLUSION CRITERIA (must be NO)",
                "field_type": "string",
                "field_order": 11,
                "field_constraint_data": "is_shown_fg=$(cohort)!=''",
                "field_constraint_description": "subtitle"
            },
            "1.12": {
                "field_name": "focal_epilepsy",
                "field_title": "Focal Epilepsy",
                "field_type": "bool",
                "field_order": 12,
                "field_constraint_data": "is_shown_fg=$(cohort)!=''"
            },
            "1.13": {
                "field_name": "mixed_syndromes",
                "field_title": "Generalized/focal epilepsy mixed syndromes",
                "field_type": "bool",
                "field_order": 13,
                "field_constraint_data": "is_shown_fg=$(cohort)!=''"
            },
            "1.14": {
                "field_name": "neurological_disorder",
                "field_title": "Progressive neurological disorder (brain tumor, AD, PME, etc)",
                "field_type": "bool",
                "field_order": 14,
                "field_constraint_data": "is_shown_fg=$(cohort)!=''"
            },
            "1.15": {
                "field_name": "encephalopathy",
                "field_title": "Epileptic or developmental encephalopathy",
                "field_type": "bool",
                "field_order": 15,
                "field_constraint_data": "is_shown_fg=$(cohort)!=''"
            },
            "1.16": {
                "field_name": "medical_comorbidities",
                "field_title": "Major medical co-morbidities such as renal failure requiring dialysis, metastatic cancer, HIV, or significant liver or renal disease",
                "field_type": "bool",
                "field_order": 16,
                "field_constraint_data": "is_shown_fg=$(cohort)!=''"
            },
            "1.17": {
                "field_name": "autism_disorder",
                "field_title": "Autism Spectrum Disorder",
                "field_type": "bool",
                "field_order": 17,
                "field_constraint_data": "is_shown_fg=$(cohort)!=''"
            },
            "1.18": {
                "field_name": "drug_alcohol_2y",
                "field_title": "History of chronic drug or alcohol abuse (misuse or excessive use that interferes with activities of daily living) within the last 2 years",
                "field_type": "bool",
                "field_order": 18,
                "field_constraint_data": "is_shown_fg=$(cohort)!=''"
            },
            "1.19": {
                "field_name": "seizures_pregnancy",
                "field_title": "Seizures only during pregnancy",
                "field_type": "bool",
                "field_order": 19,
                "field_constraint_data": "is_shown_fg=$(cohort)!=''"
            },
            "1.20": {
                "field_name": "psychiatric_disorder_interfering_study",
                "field_title": "History of previous or current significant psychiatric disorder that would interfere with conduct of the study requirements",
                "field_type": "bool",
                "field_order": 20,
                "field_constraint_data": "is_shown_fg=$(cohort)!=''"
            },
            "1.21": {
                "field_name": "exclusion_exemption",
                "field_title": "If an exemption was granted document here:",
                "field_type": "text",
                "field_order": 21,
                "field_is_optional_fg": true,
                "field_constraint_data": "is_shown_fg=$(focal_epilepsy)=='true'||$(mixed_syndromes)=='true'||$(neurological_disorder)=='true'||$(encephalopathy)=='true'||$(medical_comorbidities)=='true'||$(autism_disorder)=='true'||$(drug_alcohol_2y)=='true'||$(seizures_pregnancy)=='true'||$(psychiatric_disorder_interfering_study)=='true'||(($(cohort)=='Cohort 2'||$(cohort)=='Cohort 3')&&$(paroxysmal_nonepileptic)=='true')||($(cohort)=='Cohort 3'&&$(competing_cause)=='true')||($(cohort)=='Cohort 3'&&$(history_provoked)=='true')"
            },
            "1.22": {
                "field_description": "(Enter initials of investigator who originally\r\ncompleted this form)"
            },
            "1.23": {
                "field_name": "not_eligible",
                "field_type": "string",
                "field_order": 20.5,
                "field_constraint_data": "is_shown_fg=$(focal_epilepsy)=='true'||$(mixed_syndromes)=='true'||$(neurological_disorder)=='true'||$(encephalopathy)=='true'||$(medical_comorbidities)=='true'||$(autism_disorder)=='true'||$(drug_alcohol_2y)=='true'||$(seizures_pregnancy)=='true'||$(psychiatric_disorder_interfering_study)=='true'||(($(cohort)=='Cohort 2'||$(cohort)=='Cohort 3')&&$(paroxysmal_nonepileptic)=='true')||($(cohort)=='Cohort 3'&&$(competing_cause)=='true')||($(cohort)=='Cohort 3'&&$(history_provoked)=='true')",
                "field_constraint_description": "description",
                "field_description": "<h2 style=\"color: red;\">One or more 'Yes' is marked, the patient is not eligible to participate. </h2>"
            },
            "1.24": {
                "field_name": "inclusion_exemption",
                "field_title": "If an exemption was granted document here:",
                "field_type": "text",
                "field_order": 10.5,
                "field_is_optional_fg": true,
                "field_constraint_data": "is_shown_fg=count($(select))==0||$(eizures_history_epilepsy)=='false'||$(absence_myoclonus_convulsions)=='false'||$(seizure_prior_to_treatment)=='false'||$(complete_medication_history)=='false'||$(a8yo_diagnosis)=='false'||$(a13yo_enrollment)=='false'||$(aed_treatment_12m_prior_enrollment)=='false'||($(cohort)=='Cohort 3'&&$(treatment_resistant)=='false')"
            },
            "1.25": {
                "field_name": "cohort",
                "field_title": "Which cohort is this patient assigned to?",
                "field_type": "string",
                "field_order": 1,
                "field_constraint_data": "Cohort 1|Cohort 2|Cohort 3"
            },
            "1.26": {
                "field_name": "treatment_resistant",
                "field_title": "Treatment resistant IGE",
                "field_type": "bool",
                "field_order": 9.5,
                "field_constraint_data": "is_shown_fg=$(cohort)=='Cohort 3'",
                "field_description": "a. Initiation of treatment at least 2 years prior to enrollment\r\nb. Treatment resistance, as defined by failure of adequate trials of two tolerated and appropriately chosen and used AED schedules (whether as monotherapies or in combination to achieve seizure freedom). ASMs taken at enrollment would count towards this minimum.\r\nc. Either or both of the following two:\r\ni. One GTCC per year over the last 2 years.\r\nii. Any type of seizure at least every 3 months which can consist of either: disabling myoclonus or absence (in the opinion of the subject and investigator) or GTCC \r\nd. Such seizures were not primarily due to significant illness (e.g, URI is not significant unless temperature >101oF (38.3oC), nonadherence to antiseizure medications or >2 alcoholic beverages within 48 hrs of seizure\r\ne. Ongoing therapy with > 1 antiseizure medication"
            },
            "1.27": {
                "field_name": "paroxysmal_nonepileptic",
                "field_title": "Paroxysmal nonepileptic seizures",
                "field_type": "bool",
                "field_order": 12.5,
                "field_constraint_data": "is_shown_fg=$(cohort)=='Cohort 2'||$(cohort)=='Cohort 3'"
            },
            "1.28": {
                "field_name": "competing_cause",
                "field_title": "Competing cause of epilepsy (e.g. traumatic brain injury) ",
                "field_type": "bool",
                "field_order": 14.5,
                "field_constraint_data": "is_shown_fg=$(cohort)=='Cohort 3'"
            },
            "1.29": {
                "field_name": "history_provoked",
                "field_title": "History of/suspicion of provoked seizures accounting for 25% or more of seizures over the prior 2 years (eg alcohol, non-adherence, significant sleep deprivation). ",
                "field_type": "bool",
                "field_order": 20.1,
                "field_constraint_data": "is_shown_fg=$(cohort)=='Cohort 3'"
            }
        },
        "parent": {
            "3": "$type.hep"
        },
        "_perm": [
            {
                "party": "/system/",
                "act": {
                    "browse": true,
                    "read": true,
                    "write": true,
                    "exec": true,
                    "del": true,
                    "admin": true,
                    "share": true,
                    "download": true
                },
                "_infect": {
                    "party": [ "member" ]
                }
            }
        ]
    }
}
