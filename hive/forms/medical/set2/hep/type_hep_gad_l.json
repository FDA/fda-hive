{
    "525": {
        "_id": "$type.hep_gad_l",
        "_type": "type",
        "name": "hep_gad_l",
        "title": "Generalized Anxiety Disorder (GAD-L)",
        "fields": {
            "1.0": {
                "field_name": "question1",
                "field_title": "Since [he/she] turned five years old, has there ever been a period of time when [he/she] seemed to worry too much about a number of different things … maybe things like whether [he/she] would make good grades in school … or how [he/she] would do in sports … or that [he/she] might have some sickness or illness?",
                "field_type": "string",
                "field_order": 1,
                "field_constraint_data": "No|Yes|Refused to answer|Don't know"
            },
            "1.2": {
                "field_name": "question1subtitle1",
                "field_title": "IF NO, GO TO NEXT DIAGNOSIS",
                "field_type": "string",
                "field_order": 2,
                "field_constraint_data": "is_shown_fg=$(question1)=='No'",
                "field_constraint_description": "subtitle"
            },
            "1.3": {
                "field_name": "question1sub1",
                "field_title": "Did [his/her] worrying too much about things go on for a long time, at least for several months in a row?",
                "field_type": "string",
                "field_order": 3,
                "field_constraint_data": "No|Yes|Refused to answer|Don't know\n>is_shown_fg=$(question1)=='Yes'"
            },
            "1.4": {
                "field_name": "question1subtitle2",
                "field_title": "IF NO, GO TO NEXT DIAGNOSIS",
                "field_type": "string",
                "field_order": 4,
                "field_constraint_data": "is_shown_fg=$(question1sub1)=='No'",
                "field_constraint_description": "subtitle"
            },
            "1.5": {
                "field_name": "question1sub2",
                "field_title": "Did it seem like it was very hard for [him/her] to stop [himself/ herself] from worrying about these things?",
                "field_type": "string",
                "field_order": 5,
                "field_is_multi_fg": false,
                "field_constraint_data": "No|Yes|Refused to answer|Don't know\n>is_shown_fg=$(question1)=='Yes'"
            },
            "1.6": {
                "field_name": "question1subtitle3",
                "field_title": "IF NO, GO TO NEXT DIAGNOSIS",
                "field_type": "string",
                "field_order": 6,
                "field_constraint_data": "is_shown_fg=$(question1sub2)=='No'",
                "field_constraint_description": "subtitle"
            },
            "1.8": {
                "field_name": "question2",
                "field_title": "How old was [he/she] when [he/she] first started to worry so much? (Years)",
                "field_type": "integer",
                "field_order": 7,
                "field_is_optional_fg": true
            },
            "1.9": {
                "field_name": "question1sub1",
                "field_title": "What grade was [he/she] in?",
                "field_type": "string",
                "field_order": 8,
                "field_is_optional_fg": true,
                "field_constraint_data": "PRE-K|KINDERGARTEN|GRADE SCHOOL|COLLEGE FRESHMAN|SOPHOMORE|JUNIOR|SENIOR|POST B.A."
            },
            "1.10": {
                "field_name": "question3",
                "field_title": "How old was [he/she] when [he/she] stopped worrying that much? (Years)",
                "field_type": "integer",
                "field_order": 9,
                "field_is_optional_fg": true
            },
            "1.11": {
                "field_name": "question3sub1",
                "field_title": "What grade was [he/she] in?",
                "field_type": "string",
                "field_order": 10,
                "field_is_optional_fg": true,
                "field_constraint_data": "PRE-K|KINDERGARTEN|GRADE SCHOOL|COLLEGE FRESHMAN|SOPHOMORE|JUNIOR|SENIOR|POST B.A."
            },
            "1.13": {
                "field_name": "subtitle_1",
                "field_title": "Now I want to ask you some questions about the time [he/she] worried so much",
                "field_type": "string",
                "field_order": 11,
                "field_constraint_description": "subtitle"
            },
            "1.14": {
                "field_name": "question4",
                "field_title": "Did it seem like worrying so much made it hard for [him/her] to keep [his/her] mind on other things?",
                "field_type": "string",
                "field_order": 12,
                "field_constraint_data": "No|Yes|Refused to answer|Don't know"
            },
            "1.15": {
                "field_name": "question4subtitle1",
                "field_title": "IF YES, GO TO Q 10",
                "field_type": "string",
                "field_order": 13,
                "field_constraint_data": "is_shown_fg=$(question4)=='No'",
                "field_constraint_description": "subtitle"
            },
            "1.16": {
                "field_name": "question5",
                "field_title": "When [he/she] seemed worried like that, did [he/she] also seem tense, restless, or tired out?",
                "field_type": "string",
                "field_order": 14,
                "field_constraint_data": "No|Yes|Refused to answer|Don't know"
            },
            "1.17": {
                "field_name": "question5subtitle1",
                "field_title": "IF YES, GO TO Q 10",
                "field_type": "string",
                "field_order": 15,
                "field_constraint_data": "is_shown_fg=$(question5)=='No'",
                "field_constraint_description": "subtitle"
            },
            "1.19": {
                "field_name": "question6",
                "field_title": "When [he/she] seemed worried like that, was [he/she] grouchy or irritable a lot of the time?",
                "field_type": "string",
                "field_order": 16,
                "field_constraint_data": "No|Yes|Refused to answer|Don't know"
            },
            "1.20": {
                "field_name": "question6subtitle1",
                "field_title": "IF YES, GO TO Q 10",
                "field_type": "string",
                "field_order": 17,
                "field_constraint_data": "is_shown_fg=$(question6)=='No'",
                "field_constraint_description": "subtitle"
            },
            "1.22": {
                "field_name": "question7",
                "field_title": "Did worrying so much interfere with [his/her] sleep?",
                "field_type": "string",
                "field_order": 18,
                "field_constraint_data": "No|Yes|Refused to answer|Don't know"
            },
            "1.23": {
                "field_name": "question8",
                "field_title": "Did it seem like worrying like that gave [him/her] headaches or other aches and pains?",
                "field_type": "string",
                "field_order": 19,
                "field_constraint_data": "No|Yes|Refused to answer|Don't know"
            },
            "1.24": {
                "field_name": "question9",
                "field_title": "Did worrying like that seem to make [him/her] get tired very easily?",
                "field_type": "string",
                "field_order": 20,
                "field_constraint_data": "No|Yes|Refused to answer|Don't know"
            },
            "1.25": {
                "field_name": "question10",
                "field_title": "Did worrying so much cause any serious problems for [him/her] at home, (at school) or with [his/her] friends?",
                "field_type": "string",
                "field_order": 21,
                "field_constraint_data": "No|Yes|Refused to answer|Don't know"
            },
            "1.26": {
                "field_name": "question11",
                "field_title": "Did [he/she] ever see a doctor, counselor, or some other person like that because [he/she] worried too much?",
                "field_type": "string",
                "field_order": 22,
                "field_constraint_data": "No|Yes|Refused to answer|Don't know"
            },
            "1.27": {
                "field_name": "question12",
                "field_title": "Did worrying a lot seem to make [him/her] feel really unhappy or bother [him/her] a lot?",
                "field_type": "string",
                "field_order": 23,
                "field_constraint_data": "No|Yes|Refused to answer|Don't know"
            }
        },
        "parent": {
            "8": "$type.hep_whole_life_module"
        },
        "_perm": [
            {
                "party": "/system/",
                "act": {
                    "browse": true,
                    "read": true,
                    "write": true,
                    "exec": true,
                    "del": true,
                    "admin": true,
                    "share": true,
                    "download": true
                },
                "_infect": {
                    "party": [ "member" ]
                }
            }
        ]
    }
}
