{
    "553": {
        "_id": "$type.lup_informed_consent",
        "_type": "type",
        "name": "lup_informed_consent",
        "title": "Informed Consent",
        "fields": {
            "1.1": {
                "field_name": "consent_obtained",
                "field_title": "Was written informed consent obtained from the participant?",
                "field_type": "bool",
                "field_order": 1
            },
            "1.2": {
                "field_name": "consent_obtained_date",
                "field_title": "Date informed consent was obtained",
                "field_type": "date",
                "field_order": 1.1,
                "field_constraint_data": "{\r\n\"startDate\":\"1900\",\r\n\"endDate\":\"now\"\r\n}\r\n>is_shown_fg=$(consent_obtained)=='true'"
            },
            "1.3": {
                "field_name": "consent_reviewed",
                "field_title": "Were the Informed Consent and study procedures reviewed with the participant?",
                "field_type": "bool",
                "field_order": 2
            },
            "1.4": {
                "field_name": "questions_answered",
                "field_title": "Were all of the participant's questions answered prior to signing the Consent?",
                "field_type": "bool",
                "field_order": 3
            },
            "1.5": {
                "field_name": "consent_signed",
                "field_title": "Was the Consent signed before any study-related procedures were performed?",
                "field_type": "bool",
                "field_order": 4
            },
            "1.6": {
                "field_name": "consent_signed_staff",
                "field_title": "Did the appropriate site staff sign the Consent?",
                "field_type": "bool",
                "field_order": 5
            },
            "1.7": {
                "field_name": "copy_provided",
                "field_title": "Was a signed copy of the Consent given to the participant?",
                "field_type": "bool",
                "field_order": 6
            },
            "1.8": {
                "field_name": "consent_placed_in_file",
                "field_title": "Was the original signed and dated consent form placed in the participant's file?",
                "field_type": "bool",
                "field_order": 7
            },
            "1.9": {
                "field_name": "participant_wish_contact",
                "field_title": "Did the participant wish to be contacted about relevant molecular or genetic findings?",
                "field_type": "bool",
                "field_order": 8
            },
            "1.10": {
                "field_name": "participant_agree_extra_tissue",
                "field_title": "Did the participant agree to have an extra tissue sample taken during any biopsy for storage in the biorepository?",
                "field_type": "bool",
                "field_order": 8.1
            },
            "1.11": {
                "field_name": "latest_irb_used",
                "field_title": "Was the latest IRB approved version of the consent form used?",
                "field_type": "bool",
                "field_order": 9
            },
            "1.12": {
                "field_name": "latest_irb_used_explain",
                "field_title": "Please explain why the latest IRB approved version was not used",
                "field_type": "text",
                "field_order": 10,
                "field_constraint_data": "{'maxlength':'100'}\r\n>is_shown_fg=$(latest_irb_used)=='false'"
            }
        },
        "parent": {
            "3": "$type.lupus"
        },
        "_perm": [
            {
                "party": "/system/",
                "act": {
                    "browse": true,
                    "read": true,
                    "write": true,
                    "exec": true,
                    "del": true,
                    "admin": true,
                    "share": true,
                    "download": true
                },
                "_infect": {
                    "party": [ "member" ]
                }
            }
        ]
    }
}
