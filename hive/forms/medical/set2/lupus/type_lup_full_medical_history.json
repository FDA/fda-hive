            "1.32": {
                "field_name": "stiffness_minutes",
                "field_title": "Minutes",
                "field_type": "integer",
                "field_order": 32,
                "field_is_optional_fg": true,
                "field_constraint_data": "0-59\r\n>is_shown_fg=$(ms_morning_stiffness)=='true';",
                "field_constraint_description": "subquestion"
