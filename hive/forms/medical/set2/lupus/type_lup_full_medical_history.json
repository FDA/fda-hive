                "field_constraint_description": "subquestion"
            },
            "1.9": {
                "field_name": "constitutional_weight_loss",
                "field_title": "Recent weight loss",
                "field_type": "bool",
                "field_order": 9,
                "field_constraint_data": "is_shown_fg=true;if($(constitutional_weight_gain)=='true' && $(this)=='true'){value_fg=false};",
                "field_constraint_description": "checkbox"
            },
            "1.10": {
                "field_name": "constitutional_weight_loss_amount",
                "field_title": "amount",
                "field_type": "string",
                "field_order": 10,
                "field_constraint_data": "is_shown_fg=$(constitutional_weight_loss)=='true'",
                "field_constraint_description": "subquestion"
            },
            "1.11": {
                "field_name": "constitutional_fatigue",
                "field_title": "Fatigue",
                "field_type": "bool",
                "field_order": 11,
                "field_constraint_description": "checkbox"
            },
            "1.12": {
                "field_name": "constitutional_weakness",
                "field_title": "Weakness",
                "field_type": "bool",
                "field_order": 12,
                "field_constraint_description": "checkbox"
            },
            "1.13": {
                "field_name": "constitutional_fever",
                "field_title": "Fever",
                "field_type": "bool",
                "field_order": 13,
                "field_constraint_description": "checkbox"
            },
            "1.14": {
                "field_name": "constitutional_eyes",
                "field_title": "Eyes",
                "field_type": "string",
                "field_order": 14,
                "field_is_optional_fg": true,
                "field_is_multi_fg": true,
                "field_constraint_data": "Pain|Redness|Loss of vision|Double or blurred vision|Dryness|Feels like something in eye|Itching eyes",
                "field_constraint_description": "checkbox"
            },
            "1.15": {
                "field_name": "constitutional_enmt",
                "field_title": "Ears-Nose-Mouth-Throat",
                "field_type": "string",
                "field_order": 15,
                "field_is_optional_fg": true,
                "field_is_multi_fg": true,
                "field_constraint_data": "Ringing in ears|Loss of hearing|Nosebleeds|Loss of smell|Dryness in nose|Runny nose|Sore tongue|Bleeding gums|Sores in mouth|Loss of taste|Dryness of mouth|Frequent sore throats|Hoarseness|Difficulty swallowing",
                "field_constraint_description": "checkbox"
            },
            "1.16": {
                "field_name": "constitutional_cardiovascular",
                "field_title": "Cardiovascular",
                "field_type": "string",
                "field_order": 16,
                "field_is_optional_fg": true,
                "field_is_multi_fg": true,
                "field_constraint_data": "Chest pain|Irregular heart beat|Sudden changes in heart beat|High blood pressure|Heart murmurs",
                "field_constraint_description": "checkbox"
            },
            "1.17": {
                "field_name": "constitutional_respiratory",
                "field_title": "Respiratory",
                "field_type": "string",
