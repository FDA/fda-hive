                "field_order": 18,
                "field_is_optional_fg": true,
                "field_is_multi_fg": true,
                "field_constraint_data": "Nausea|Vomiting of blood or coffee ground material|Stomach pain relieved by food or milk|Jaundice|Increasing constipation|Persistent diarrhea|Blood in stools|Black stools|Heartburn",
                "field_constraint_description": "checkbox"
            },
            "1.19": {
                "field_name": "constitutional_genitourinary",
                "field_title": "Genitourinary",
                "field_type": "string",
                "field_order": 19,
                "field_is_optional_fg": true,
                "field_is_multi_fg": true,
                "field_constraint_data": "Difficult urination|Pain or burning on urination|Blood in urine|Cloudy, “smoky” urine|Pus in urine|Discharge from penis/vagina|Getting up at night to pass urine|Vaginal dryness|Rash/ulcers|Sexual difficulties|Prostate trouble",
                "field_constraint_description": "checkbox"
            },
            "1.20": {
                "field_name": "subtitle_3",
                "field_title": "For Women Only",
                "field_type": "string",
                "field_order": 20,
                "field_constraint_description": "subtitle"
