{
    "550": {
        "_id": "$type.lup_full_medical_history",
        "_type": "type",
        "name": "lup_full_medical_history",
        "title": "Full Medical History",
        "fields": {
            "1.1": {
                "field_name": "subtitle_1",
                "field_title": "PAST MEDICAL HISTORY",
                "field_type": "string",
                "field_order": 1,
                "field_constraint_description": "subtitle"
            },
            "1.2": {
                "field_name": "participant_ever_had",
                "field_title": "Does the participant now have or ever had: (check if \"yes\")",
                "field_type": "string",
                "field_order": 2,
                "field_is_multi_fg": true,
                "field_constraint_data": "Cancer|Goiter|Cataracts|Nervous breakdown|Bad headaches|Kidney disease|Anemia|Emphysema|Heart problems|Leukemia|Diabetes|Stomach ulcers|Jaundice|Pneumonia|HIV/AIDS|Glaucoma|Asthma|Stroke|Epilepsy|Rheumatic fever|Colitis|Psoriasis|High blood pressure|Tuberculosis|No illnesses|Doesn't know|Other significant illness\r\n>$(this);let nonval='No illnesses';let triggeredVal=surveyState.triggeredAnswer?surveyState.question.answers.filter(y=>y.id==surveyState.triggeredAnswer)[0].value : null;if(triggeredVal==nonval){value_fg=nonval;surveyState.answer=[surveyState.question.answers.filter(y=>y.value ==nonval)[0].id];}else if(triggeredVal){surveyState.answer=surveyState.answer.filter(x=>x!=surveyState.question.answers.filter(y=>y.value==nonval)[0].id);}nonval=\"Doesn't know\";triggeredVal=surveyState.triggeredAnswer?surveyState.question.answers.filter(y=>y.id==surveyState.triggeredAnswer)[0].value : null;if(triggeredVal==nonval){value_fg=nonval;surveyState.answer=[surveyState.question.answers.filter(y=>y.value ==nonval)[0].id];}else if(triggeredVal){surveyState.answer=surveyState.answer.filter(x=>x!=surveyState.question.answers.filter(y=>y.value==nonval)[0].id);}",
                "field_constraint_description": "checkbox"
            },
            "1.3": {
                "field_name": "participant_ever_had_other",
                "field_title": "Please list",
                "field_type": "text",
                "field_order": 3,
                "field_constraint_data": "is_shown_fg=$(participant_ever_had)=='Other significant illness'",
                "field_constraint_description": "subquestion"
            },
            "1.4": {
                "field_name": "therapies",
                "field_title": "Natural or Alternative Therapies (chiropractic, magnets, massage, over-the-counter preparations, etc.):",
                "field_type": "text",
                "field_order": 4,
                "field_is_optional_fg": true,
                "field_constraint_data": "{\"maxlength\":\"100\"}"
            },
            "1.5": {
                "field_name": "subtitle_2",
                "field_title": "LUPUS MANIFESTATIONS HISTORY",
                "field_type": "string",
                "field_order": 5,
                "field_constraint_description": "subtitle"
            },
            "1.6": {
                "field_name": "constitutional_title",
                "field_title": "Constitutional",
                "field_type": "string",
                "field_order": 6,
                "field_constraint_description": "description",
                "field_description": "Constitutional"
            },
            "1.7": {
                "field_name": "constitutional_weight_gain",
                "field_title": "Recent weight gain",
                "field_type": "bool",
                "field_order": 7,
                "field_constraint_data": "is_shown_fg=true;if($(constitutional_weight_loss)=='true' && $(this)=='true'){value_fg=false};",
                "field_constraint_description": "checkbox"
            },
            "1.8": {
                "field_name": "constitutional_weight_gain_amount",
                "field_title": "amount",
                "field_type": "string",
                "field_order": 8,
