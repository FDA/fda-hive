{
    "540": {
        "_id": "$type.lup_contact_information",
        "_type": "type",
        "name": "lup_contact_information",
        "title": "Contact Information",
        "fields": {
            "1.1": {
                "field_name": "street_number",
                "field_title": "Street Number",
                "field_type": "integer",
                "field_order": 1,
                "field_constraint_data": "0-100000"
            },
            "1.2": {
                "field_name": "street_name",
                "field_title": "Street Name",
                "field_type": "string",
                "field_order": 2,
                "field_constraint_data": "{\"maxlength\":\"100\"}"
            },
            "1.3": {
                "field_name": "city",
                "field_title": "City",
                "field_type": "string",
                "field_order": 3,
                "field_constraint_data": "{\"maxlength\":\"100\"}"
            },
            "1.4": {
                "field_name": "country",
                "field_title": "Country",
                "field_type": "string",
                "field_order": 4,
                "field_constraint_data": "USA|Canada"
            },
            "1.5": {
                "field_name": "us_state",
                "field_title": "State",
                "field_type": "string",
                "field_order": 5,
                "field_constraint": "search",
                "field_constraint_data": "{\r\n\"fetch\":[\"Code\"],\r\n\"url\":\"?cmd=file&mode=csv&filename=voc/us_states.csv&raw=1&start=0\",\r\n\"inline\":[\r\n\t{\"name\":\"Code\",\"title\":\"Code\",\"display\":\"none\",\"search\":\"true\"},\r\n\t{\"name\":\"State\",\"title\":\"State\",\"display\":\"title\",\"search\":\"true\"}\r\n],\r\n\"outline\":[\r\n\t{\"name\":\"Code\",\"title\":\"Code\"},\r\n\t{\"name\":\"State\",\"title\":\"State\"}\r\n]\r\n}\r\n>is_shown_fg=$(country)=='USA'"
            },
            "1.6": {
                "field_name": "ca_province",
                "field_title": "Province",
                "field_type": "string",
                "field_order": 6,
                "field_constraint": "search",
                "field_constraint_data": "{\r\n\"fetch\":[\"Code\"],\r\n\"url\":\"?cmd=file&mode=csv&filename=voc/ca_states.csv&raw=1&start=0\",\r\n\"inline\":[\r\n\t{\"name\":\"Code\",\"title\":\"Code\",\"display\":\"none\",\"search\":\"true\"},\r\n\t{\"name\":\"State\",\"title\":\"State\",\"display\":\"title\",\"search\":\"true\"}\r\n],\r\n\"outline\":[\r\n\t{\"name\":\"Code\",\"title\":\"Code\"},\r\n\t{\"name\":\"State\",\"title\":\"State\"}\r\n]\r\n}\r\n>is_shown_fg=$(country)=='Canada'"
            },
            "1.7": {
                "field_name": "zip_us",
                "field_title": "Zip Code",
                "field_type": "string",
                "field_order": 7,
                "field_constraint_data": "{\"maxlength\":\"5\",\"placeholder\":\"NNNNN\"}\r\n>is_shown_fg=$(country)=='USA';value_fg='$(this)';var valid = /^\\d{5}$/g.test(value_fg);has_error=(!valid).toString();if(!valid){error_message='Insert correct Zip Code';}else{has_error='false';error_message='';}"
            },
            "1.8": {
                "field_name": "zip_ca",
                "field_title": "Zip Code",
                "field_type": "string",
                "field_order": 8,
                "field_constraint_data": "{\"maxlength\":\"7\",\"placeholder\":\"ANA NAN\"}\r\n>is_shown_fg=$(country)=='Canada';let input = '$(this)';input = input.replace(/[^A-Za-z0-9]/g, \"\");input = input.toUpperCase();if (input.length > 3) {input = input.slice(0, 3) + \" \" + input.slice(3);}if (input.length > 7) {input = input.slice(0, 7);}surveyState.inputAnswer = [];value_fg=input;surveyState.inputAnswer.push(value_fg);var valid = /^[A-Za-z]\\d[A-Za-z] \\d[A-Za-z]\\d$/g.test(value_fg);has_error=(!valid).toString();if(!valid&&value_fg!=''){error_message='Insert correct Zip Code';}else{has_error='false';error_message='';}"
            },
            "1.9": {
                "field_name": "phone_parent",
                "field_title": "Phone",
                "field_type": "array",
                "field_order": 9,
                "field_is_multi_fg": true,
                "field_constraint_description": "col-6"
            },
            "1.10": {
                "field_name": "phone_number",
                "field_title": "Phone Number",
                "field_type": "string",
                "field_parent": "phone_parent",
                "field_order": 9.1,
                "field_constraint_description": "phone"
            },
            "1.11": {
                "field_name": "phone_type",
                "field_title": "Type",
                "field_type": "string",
                "field_parent": "phone_parent",
                "field_order": 9.2,
                "field_constraint_data": "Home|Cell|Work|Other"
            },
            "1.12": {
                "field_name": "email",
                "field_title": "Email Address",
                "field_type": "string",
                "field_order": 11,
                "field_constraint_description": "email"
            },
            "1.13": {
                "field_name": "emergency_contact_name",
                "field_title": "Emergency Contact Name",
                "field_type": "string",
                "field_order": 12,
                "field_constraint_data": "{\"maxlength\":\"100\"}"
            },
            "1.14": {
                "field_name": "emergency_phone",
                "field_title": "Emergency Contact Phone Number",
                "field_type": "string",
                "field_order": 13,
                "field_constraint_description": "phone"
            }
        },
        "parent": {
            "3": "$type.lupus"
        },
        "_perm": [
            {
                "party": "/system/",
                "act": {
                    "browse": true,
                    "read": true,
                    "write": true,
                    "exec": true,
                    "del": true,
                    "admin": true,
                    "share": true,
                    "download": true
                },
                "_infect": {
                    "party": [ "member" ]
                }
            }
        ]
    }
}
