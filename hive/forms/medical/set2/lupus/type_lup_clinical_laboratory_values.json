{
    "539": {
        "_id": "$type.lup_clinical_laboratory_values",
        "_type": "type",
        "name": "lup_clinical_laboratory_values",
        "title": "Clinical Laboratory Values",
        "fields": {
            "1.1": {
                "field_name": "wbc",
                "field_title": "WBC (10<sup>9</sup>/L)",
                "field_type": "real",
                "field_order": 1,
                "field_is_optional_fg": true,
                "field_constraint_data": "0-100000",
                "field_description": "billion per liter"
            },
            "1.2": {
                "field_name": "alc",
                "field_title": "Absolute Lymphocyte Count (10<sup>9</sup>/L)",
                "field_type": "real",
                "field_order": 2,
                "field_is_optional_fg": true,
                "field_constraint_data": "0-10",
                "field_description": "billion per liter"
            },
            "1.3": {
                "field_name": "hgb",
                "field_title": "HGB (g/dL)",
                "field_type": "real",
                "field_order": 3,
                "field_is_optional_fg": true,
                "field_constraint_data": "0-30",
                "field_description": "grams per deciliter"
            },
            "1.4": {
                "field_name": "hct",
                "field_title": "HCT (%, L/L)",
                "field_type": "real",
                "field_order": 4,
                "field_is_optional_fg": true,
                "field_constraint_data": "0-100",
                "field_description": "percent"
            },
            "1.5": {
                "field_name": "platelets",
                "field_title": "Platelets (g/dL)",
                "field_type": "integer",
                "field_order": 5,
                "field_is_optional_fg": true,
                "field_constraint_data": "0-1000",
                "field_description": "billion per liter"
            },
            "1.6": {
                "field_name": "bun",
                "field_title": "BUN (mg/dL)",
                "field_type": "real",
                "field_order": 6,
                "field_is_optional_fg": true,
                "field_constraint_data": "0-100",
                "field_description": "milligrams per deciliter"
            },
            "1.7": {
                "field_name": "serum_creatinine",
                "field_title": "Serum Creatinine (mg/dL)",
                "field_type": "real",
                "field_order": 7,
                "field_is_optional_fg": true,
                "field_constraint_data": "0-5",
                "field_description": "milligrams per deciliter"
            },
            "1.8": {
                "field_name": "total_protein",
                "field_title": "Total Protein (g/dL)",
                "field_type": "real",
                "field_order": 8,
                "field_is_optional_fg": true,
                "field_constraint_data": "0-20",
                "field_description": "grams per deciliter"
            },
            "1.9": {
                "field_name": "albumin",
                "field_title": "Albumin (g/dL)",
                "field_type": "real",
                "field_order": 9,
                "field_is_optional_fg": true,
                "field_constraint_data": "0-10",
                "field_description": "grams per deciliter"
            },
            "1.10": {
                "field_name": "alt",
                "field_title": "ALT (IU/L)",
                "field_type": "real",
                "field_order": 10,
                "field_is_optional_fg": true,
                "field_constraint_data": "0-200",
                "field_description": "unit per liter"
            },
            "1.11": {
                "field_name": "ast",
                "field_title": "AST (IU/L)",
                "field_type": "real",
                "field_order": 11,
                "field_is_optional_fg": true,
                "field_constraint_data": "0-10000",
                "field_description": "unit per liter"
            },
            "1.12": {
                "field_name": "alp",
                "field_title": "ALP (IU/L)",
                "field_type": "real",
                "field_order": 12,
                "field_is_optional_fg": true,
                "field_constraint_data": "0-10000",
                "field_description": "unit per liter"
            },
            "1.13": {
                "field_name": "dsdna",
                "field_title": "dsDNA (IU/mL)",
                "field_type": "real",
                "field_order": 12.1,
                "field_is_optional_fg": true,
                "field_constraint_data": "0-10000",
                "field_description": "unit per milliliter"
            },
            "1.14": {
                "field_name": "dsdna_abnormally_elevated",
                "field_title": "Abnormally elevated",
                "field_type": "bool",
                "field_order": 12.2,
                "field_constraint_description": "checkbox"
            },
            "1.15": {
                "field_name": "dsdna_abnormally_elevated_value",
                "field_title": "Lower limit for dsDNA for abnormally elevated",
                "field_type": "real",
                "field_order": 12.3,
                "field_is_optional_fg": true,
                "field_constraint_data": "is_shown_fg=$(dsdna_abnormally_elevated)=='true';if(parseInt($(this))>parseInt('$(dsdna)')){has_error=true;error_message='dsDNA: Lower limit should be less than actual value.';}else if($(this)!='') {has_error=false;error_message=''} ",
                "field_constraint_description": "subquestion",
                "field_description": "abnormal does not include indeterminate results"
            },
            "1.16": {
                "field_name": "c3",
                "field_title": "C3 (mg/dL)",
                "field_type": "real",
                "field_order": 12.4,
                "field_is_optional_fg": true,
                "field_constraint_data": "0-10000",
                "field_description": "milligrams per deciliter"
            },
            "1.17": {
                "field_name": "c3_abnormally_low",
                "field_title": "Abnormally low",
                "field_type": "bool",
                "field_order": 12.5,
                "field_constraint_description": "checkbox"
            },
            "1.18": {
                "field_name": "c3_abnormally_low_value",
                "field_title": "Upper limit for abnormally low",
                "field_type": "real",
                "field_order": 12.6,
                "field_is_optional_fg": true,
                "field_constraint_data": "is_shown_fg=$(c3_abnormally_low)=='true';if(parseInt($(this))<parseInt('$(c3)')){has_error=true;error_message='C3: Upper limit should be higher than actual value.';}else if($(this)!='') {has_error=false;error_message=''} ",
                "field_constraint_description": "subquestion",
                "field_description": "abnormal does not include indeterminate results"
            },
            "1.19": {
                "field_name": "c4",
                "field_title": "C4 (mg/dL)",
                "field_type": "real",
                "field_order": 12.7,
                "field_is_optional_fg": true,
                "field_constraint_data": "0-10000",
                "field_description": "milligrams per deciliter"
            },
            "1.20": {
                "field_name": "c4_abnormally_low",
                "field_title": "Abnormally low",
                "field_type": "bool",
                "field_order": 12.8,
                "field_constraint_description": "checkbox"
            },
            "1.21": {
                "field_name": "c4_abnormally_low_value",
                "field_title": "Upper limit for abnormally low",
                "field_type": "real",
                "field_order": 12.9,
                "field_is_optional_fg": true,
                "field_constraint_data": "is_shown_fg=$(c4_abnormally_low)=='true';if(parseInt($(this))<parseInt('$(c4)')){has_error=true;error_message='C4: Upper limit should be higher than actual value.';}else if($(this)!='') {has_error=false;error_message=''} ",
                "field_constraint_description": "subquestion",
                "field_description": "abnormal does not include indeterminate results"
            },
            "1.22": {
                "field_name": "upcr",
                "field_title": "uPCR (mg/mg)",
                "field_type": "real",
                "field_order": 13,
                "field_is_optional_fg": true,
                "field_constraint_data": "0-10000",
                "field_description": "urine protein: creatinine ratio"
            },
            "1.23": {
                "field_name": "urine_protein",
                "field_title": "Urine protein (mg/dL)",
                "field_type": "real",
                "field_order": 14,
                "field_is_optional_fg": true,
                "field_constraint_data": "0-800",
                "field_description": "milligrams per deciliter"
            },
            "1.24": {
                "field_name": "urine_creatinine ",
                "field_title": "Urine creatinine (mg/dL)",
                "field_type": "real",
                "field_order": 14.5,
                "field_is_optional_fg": true,
                "field_constraint_data": "0-800",
                "field_description": "milligrams per deciliter"
            },
            "1.25": {
                "field_name": "urine_rbc",
                "field_title": "Urine RBC (RBC/HPF)",
                "field_type": "real",
                "field_order": 15,
                "field_is_optional_fg": true,
                "field_constraint_data": "0-100",
                "field_description": "red blood cells per high power field"
            },
            "1.26": {
                "field_name": "urine_wbc",
                "field_title": "Urine WBC (WBC/HPF)",
                "field_type": "real",
                "field_order": 16,
                "field_is_optional_fg": true,
                "field_is_summary_fg": false,
                "field_constraint_data": "0-100",
                "field_description": "white blood cells per high power field"
            },
            "1.27": {
                "field_name": "egfr",
                "field_title": "eGFR (mL/min/1.73m<sup>2</sup>)",
                "field_type": "real",
                "field_order": 17,
                "field_is_optional_fg": true,
                "field_constraint_data": "0-1000",
                "field_description": "estimated glomerular filtration rate"
            }
        },
        "parent": {
            "3": "$type.lupus"
        },
        "_perm": [
            {
                "party": "/system/",
                "act": {
                    "browse": true,
                    "read": true,
                    "write": true,
                    "exec": true,
                    "del": true,
                    "admin": true,
                    "share": true,
                    "download": true
                },
                "_infect": {
                    "party": [ "member" ]
                }
            }
        ]
    }
}
