            "1.1": {
                "field_name": "ocular_title",
                "field_title": "Ocular",
                "field_type": "string",
                "field_order": 2,
                "field_constraint_description": "titledescription"
            },
            "1.2": {
                "field_name": "cataract",
                "field_title": "Any cataract ever (1)",
                "field_type": "bool",
                "field_order": 3,
                "field_constraint_data": "total_score=total_score+($(this)=='true'?1:0);"
            },
            "1.3": {
                "field_name": "retinal_change_optic_atrophy",
                "field_title": "Retinal change or optic atrophy (1)",
                "field_type": "bool",
                "field_order": 4,
                "field_constraint_data": "total_score=total_score+($(this)=='true'?1:0);"
            },
            "1.4": {
