{
    "573": {
        "_id": "$type.lup_slicc_acr_damage_index",
        "_type": "type",
        "name": "lup_slicc_acr_damage_index",
        "title": "SLICC/ACR Damage Index",
        "description": "<h5>Assess for each item the damage (nonreversible change, not related to active inflammation) occurring since onset of lupus and present for at least 6 months unless otherwise stated. Repeat episodes must occur at least 6 months apart to score 2. The same lesion cannot be scored twice. </h5>",
