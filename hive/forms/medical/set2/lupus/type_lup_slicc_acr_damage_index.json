                "field_constraint_data": "total_score=total_score+($(this)=='true'?1:0);",
                "field_description": "(*)Memory deficit, difficulty with calculation, poor concentration, difficulty with spoken or written language, impaired performance level"
            },
            "1.6": {
                "field_name": "seizures_requiring_therapy",
