{
    "559": {
        "_id": "$type.lup_rsfi",
        "_type": "type",
        "name": "lup_rsfi",
        "title": "Selena Flare Index (rSFI)",
        "description": "<h5>Check box: if descriptor is present at the time of visit or in the preceding 10 days</h5>",
        "fields": {
            "1.1": {
                "field_name": "ms_title",
                "field_title": "MUCOCUTANEOUS SYSTEM",
                "field_type": "string",
                "field_order": 1,
                "field_constraint_description": "subtitle"
            },
            "1.2": {
                "field_name": "ms_none",
                "field_title": "None",
                "field_type": "bool",
                "field_order": 2,
                "field_constraint_data": "if($(this)=='true'&& !($(ms_mild)=='false'&&$(ms_moderate)=='false'&&$(ms_severe)=='false')) {value_fg='false'}",
                "field_constraint_description": "checkbox"
            },
            "1.3": {
                "field_name": "ms_mild",
                "field_title": "Mild",
                "field_type": "bool",
