{
    "561": {
        "_id": "$type.lup_sc_dxterity_finger_prick",
        "_type": "type",
        "name": "lup_sc_dxterity_finger_prick",
        "title": "Finger Prick (Whole Blood)",
        "fields": {
            "1.1": {
                "field_name": "subtitle_1",
                "field_title": "Finger Prick Kit",
                "field_type": "string",
                "field_order": 1,
                "field_constraint_description": "subtitle"
            },
            "1.2": {
                "field_name": "how_many_kits",
                "field_title": "How many DxCollect MicroCollection Device kits were used for the study participant during the visit?",
                "field_type": "string",
                "field_order": 1.5,
                "field_constraint_data": "None|One for the participant to bring back home|One for the participant to bring back home and one for immediate use during the visit"
            },
            "1.3": {
                "field_name": "kit_not_handed_reason",
                "field_title": "Please select the reason why the kit was not handed during the visit",
                "field_type": "string",
                "field_order": 3,
                "field_is_multi_fg": true,
                "field_constraint_data": "Study participant declined|Sample collection kits unavailable|Kit was mailed to the study participant|Other\r\n>is_shown_fg=$(how_many_kits)=='None'"
            },
            "1.4": {
                "field_name": "sample_not_collected_reason_other",
                "field_title": "Please specify",
                "field_type": "string",
                "field_order": 4,
                "field_constraint_data": "{\"maxlength\":\"50\"}\r\n>is_shown_fg=$(how_many_kits)=='None'&&$(kit_not_handed_reason)=='Other'",
                "field_constraint_description": "subquestion"
            },
            "1.5": {
                "field_name": "participant_given_instructions",
                "field_title": "Was the study participant given instructions on how to use the DxCollect MicroCollection Device kit?",
                "field_type": "bool",
                "field_order": 5,
                "field_constraint_data": "is_shown_fg=$(how_many_kits)!='None'&&$(how_many_kits)!=''"
            },
            "1.6": {
                "field_name": "why_instructions_not_given",
                "field_title": "Please explain why instructions were not given to the study participant",
                "field_type": "string",
                "field_order": 6,
                "field_constraint_data": "Study participant declined|Other\r\n>is_shown_fg=$(how_many_kits)!='None'&&$(how_many_kits)!=''&&$(participant_given_instructions)=='false'"
            },
            "1.7": {
                "field_name": "why_instructions_not_given_other",
                "field_title": "Please specify",
                "field_type": "string",
                "field_order": 6.5,
                "field_constraint_data": "{\"maxlength\":\"50\"}\r\n>is_shown_fg=$(how_many_kits)!='None'&&$(how_many_kits)!=''&&$(participant_given_instructions)=='false'&&$(why_instructions_not_given)=='Other'",
                "field_constraint_description": "subquestion"
            },
            "1.8": {
                "field_name": "subtitle_2",
                "field_title": "Please scan the DxCollect blood vial and scan the shipping envelope shipped during the visit",
                "field_type": "string",
                "field_order": 7,
                "field_constraint_data": "is_shown_fg=$(how_many_kits)!='None'&&$(how_many_kits)!=''",
                "field_constraint_description": "subtitle",
                "field_description": "Scan the vial's barcode"
            },
            "1.9": {
                "field_name": "tube_1",
                "field_title": "Vial ID",
                "field_type": "string",
                "field_order": 8,
                "field_constraint_data": "{\"maxlength\":\"10\"}\r\n>is_shown_fg=$(how_many_kits)!='None'&&$(how_many_kits)!=''",
                "field_constraint_description": "barcode"
            },
            "1.10": {
                "field_name": "shipped_during_visit",
                "field_title": "Click here if you shipped the DxCollect blood sample during the visit",
                "field_type": "bool",
                "field_order": 9,
                "field_constraint_data": "is_shown_fg=$(how_many_kits)!='None'&&$(how_many_kits)!=''",
                "field_constraint_description": "checkbox"
            },
            "1.11": {
                "field_name": "tracking_no_1",
                "field_title": "Shipment Tracking Number",
                "field_type": "string",
                "field_order": 10,
                "field_constraint_data": "{\"maxlength\":\"22\"}\r\n>is_shown_fg=$(how_many_kits)!='None'&&$(how_many_kits)!=''&&$(shipped_during_visit)=='true'",
                "field_constraint_description": "barcode"
            },
            "1.12": {
                "field_name": "shipment_date_1",
                "field_title": "Shipment Date",
                "field_type": "date",
                "field_order": 11,
                "field_constraint_data": "{\r\n\"startDate\":\"1900\",\r\n\"endDate\":\"now\"\r\n}\r\n>is_shown_fg=$(how_many_kits)!='None'&&$(how_many_kits)!=''&&$(shipped_during_visit)=='true'"
            },
            "1.13": {
                "field_name": "subtitle_3",
                "field_title": "Please scan the DxCollect blood vial and scan the shipping envelope that the participant brought at home",
                "field_type": "string",
                "field_order": 12,
                "field_constraint_data": "is_shown_fg=$(how_many_kits)=='One for the participant to bring back home and one for immediate use during the visit'",
                "field_constraint_description": "subtitle",
                "field_description": "Scan the vial's barcode"
            },
            "1.14": {
                "field_name": "tube_2",
                "field_title": "Vial ID",
                "field_type": "string",
                "field_order": 13,
                "field_constraint_data": "{\"maxlength\":\"10\"}\r\n>is_shown_fg=$(how_many_kits)=='One for the participant to bring back home and one for immediate use during the visit'",
                "field_constraint_description": "barcode"
            },
            "1.15": {
                "field_name": "tracking_no_2",
                "field_title": "Shipment Tracking Number",
                "field_type": "string",
                "field_order": 14,
                "field_constraint_data": "{\"maxlength\":\"22\"}\r\n>is_shown_fg=$(how_many_kits)=='One for the participant to bring back home and one for immediate use during the visit'",
                "field_constraint_description": "barcode"
            }
        },
        "parent": {
            "3": "$type.lup_sample_collection"
        },
        "_perm": [
            {
                "party": "/system/",
                "act": {
                    "browse": true,
                    "read": true,
                    "write": true,
                    "exec": true,
                    "del": true,
                    "admin": true,
                    "share": true,
                    "download": true
                },
                "_infect": {
                    "party": [ "member" ]
                }
            }
        ]
    }
}
