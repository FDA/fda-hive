                "field_name": "scaleVectorsByValue",
                "field_title": "Scale vector coefficients by eigenvalue",
                "field_type": "integer",
                "field_parent": "output",
                "field_is_optional_fg": true,
                "field_constraint": "choice",
                "field_constraint_data": "0//do not scale|1///scale"
            },
            "1.29": {
                "field_name": "zeroMax",
                "field_title": "Maximum number of zeros allowed for a row",
                "field_type": "real",
                "field_parent": "filters",
                "field_default_value": "-1",
                "field_constraint": "choice+",
                "field_constraint_data": "-1///any number of zeros are allowed"
            },
            "1.31": {
                "field_name": "minimalOut",
                "field_title": "Minimize Output",
                "field_type": "bool",
                "field_parent": "output",
                "field_default_value": "0"
            },
