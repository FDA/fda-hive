                "field_title": "Output",
                "field_type": "list",
                "field_order": 5
            },
            "1.48": {
                "field_name": "check-list",
                "field_title": "Checks",
                "field_type": "list"
            },
            "1.50": {
                "field_name": "continous-grp",
                "field_title": "Continous Classifier",
                "field_type": "list",
                "field_parent": "classifier-list"
            },
            "1.52": {
                "field_name": "topChoiceForFinal",
                "field_title": "Final Classifier Dimension",
                "field_type": "integer",
                "field_order": 8,
                "field_default_value": "700"
            },
            "1.54": {
                "field_name": "includeCats",
                "field_title": "Include Categories",
                "field_type": "string",
                "field_is_optional_fg": true,
                "field_is_multi_fg": true
            }
