                "field_name": "funcType",
                "field_title": "Functions",
                "field_type": "string",
                "field_parent": "classifier-list",
                "field_order": 5,
                "field_default_value": "0",
                "field_is_multi_fg": true,
                "field_constraint": "choice",
                "field_constraint_data": "linear///Linear Discriminant|enzymatic///Non-Linear metabolomic kinetics|quadratic///Quadratic discriminant"
            },
            "1.20": {
                "field_name": "matrix",
                "field_title": "As pasted CSV text",
                "field_type": "text",
                "field_parent": "matrixGroup",
                "field_order": 2,
                "field_is_optional_fg": true,
                "field_description": "Enter the matrix of measured variables"
            },
            "1.21": {
                "field_name": "matrixFile",
                "field_title": "Matrix File",
                "field_type": "obj",
                "field_parent": "matrixGroup",
                "field_order": 1,
                "field_is_optional_fg": true,
                "field_is_multi_fg": true,
                "field_is_batch_fg": true,
                "field_constraint": "type",
                "field_constraint_data": "u-file,csv-table"
            },
            "1.22": {
                "field_name": "matrixGroup",
                "field_title": "Matrix of Measurables",
                "field_type": "list",
                "field_order": 1
            },
            "1.23": {
                "field_name": "matrixTransposed",
                "field_title": "Samples are first row (instead of first column)",
                "field_type": "bool",
                "field_parent": "matrixGroup",
                "field_order": 3,
                "field_is_optional_fg": true,
                "field_description": "Is the list of samples in the first row (as opposed to first column)?"
            },
            "1.24": {
                "field_name": "nonZeroMin",
                "field_title": "Minimal number of non zeros allowed for a row",
                "field_type": "real",
                "field_parent": "filters",
                "field_default_value": "0"
            },
            "1.25": {
                "field_name": "nrepeat",
                "field_title": "Number of Computational Threads",
                "field_type": "integer",
                "field_parent": "splitList",
                "field_default_value": "1",
                "field_is_optional_fg": true,
                "field_constraint": "eval",
                "field_constraint_data": "!isNaN(\"$_(val)\")",
                "field_constraint_description": "Give a Number"
            },
            "1.26": {
                "field_name": "PCAMode",
                "field_title": "Classifier Mode",
                "field_type": "integer",
                "field_parent": "classifier-list",
                "field_order": 0,
                "field_default_value": "0",
                "field_constraint": "choice",
                "field_constraint_data": "0///RLDA|1///PCA"
            },
            "1.27": {
                "field_name": "readNumsAsNums",
                "field_title": "Numeric Value interpetations",
                "field_type": "integer",
                "field_parent": "parsing",
                "field_order": 4,
                "field_default_value": "0",
                "field_constraint": "choice",
                "field_constraint_data": "0///do not interpet numbers as numbers in categorical columns|1///Interpret numerals as numbers even in categorical columns"
            },
