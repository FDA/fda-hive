                "field_parent": "check-list",
                "field_order": 6
            },
            "1.10": {
                "field_name": "checkMatrix",
                "field_title": "As pasted CSV text",
                "field_type": "text",
                "field_parent": "checkMatrixGroup",
                "field_order": 2,
                "field_is_optional_fg": true,
                "field_description": "Enter the matrix of measured variables"
            },
            "1.11": {
                "field_name": "checkMatrixFile",
                "field_title": "As file object",
                "field_type": "obj",
                "field_parent": "checkMatrixGroup",
                "field_order": 1,
                "field_is_optional_fg": true,
                "field_constraint": "type",
                "field_constraint_data": "u-file,csv-table"
            },
            "1.12": {
                "field_name": "checkMatrixGroup",
                "field_title": "Check Matrix Measureables",
                "field_type": "list",
                "field_parent": "check-list",
                "field_order": 1
            },
            "1.13": {
                "field_name": "classifier",
                "field_title": "Classifier Column",
                "field_type": "integer",
                "field_parent": "classifier-list",
                "field_order": 1,
                "field_default_value": "0",
                "field_is_multi_fg": true,
                "field_is_batch_fg": true,
                "field_constraint": "choice",
                "field_constraint_data": "0|1|2",
                "field_constraint_description": "Select the column to server as classifier",
                "field_description": "This value will be used to classify the samples"
            },
