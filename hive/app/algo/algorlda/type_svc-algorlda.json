                "field_title": "Minimum",
                "field_type": "string",
                "field_parent": "continous-grp",
                "field_order": 1,
                "field_default_value": "auto",
                "field_is_optional_fg": true,
                "field_is_multi_fg": false,
                "field_constraint": "choice+",
                "field_constraint_data": "order///Sort order base ranking|auto///Autodetermine the range"
            },
            "1.36": {
                "field_name": "continousPhenotypeMax",
                "field_title": "Maximum",
                "field_type": "string",
                "field_parent": "continous-grp",
                "field_order": 2,
                "field_default_value": "auto",
                "field_is_optional_fg": true,
                "field_constraint": "choice+",
                "field_constraint_data": "order///Sort order base ranking|auto///Autodetermine the range"
            },
            "1.38": {
                "field_name": "scaleMode",
                "field_title": "Scale Mode",
                "field_type": "integer",
                "field_parent": "parsing",
                "field_default_value": "1",
                "field_constraint": "choice",
                "field_constraint_data": "0///do not scale|1///z-scale|2///unit scale"
            },
            "1.39": {
