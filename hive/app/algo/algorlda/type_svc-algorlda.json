{
    "330": {
        "_id": "$type.svc-algorlda",
        "_type": "type",
        "name": "svc-algorlda",
        "title": "RLDA tools",
        "description": "// Clusterization and classification RLDA Utility\nlocation: hive.app.algo.algorlda",
        "parent": {
            "1": "$type.svc-AIML"
        },
        "prefetch": true,
        "fields": {
            "1.1": {
                "field_name": "binThreshold",
                "field_title": "Threshold for binary values",
                "field_type": "real",
                "field_parent": "parsing",
                "field_default_value": "1",
                "field_is_optional_fg": true,
                "field_is_batch_fg": true
            },
            "1.2": {
                "field_name": "bootStrapCounter",
                "field_title": "Bootstrap every so many steps",
                "field_type": "integer",
                "field_parent": "bootstrap",
                "field_order": 6,
                "field_default_value": "0",
                "field_is_optional_fg": true,
                "field_constraint": "choice+",
                "field_constraint_data": "0///do not bootstrap",
                "field_constraint_description": "|10000///10000 steps|1000///1000 steps",
                "field_description": "How frequently to bootstrap the samples"
            },
            "1.3": {
                "field_name": "bootStrapFraction",
                "field_title": "Bootstrap core fraction",
                "field_type": "real",
                "field_parent": "bootstrap",
                "field_order": 7,
                "field_default_value": "0.9",
                "field_is_optional_fg": true,
                "field_description": "The fraction of samples in maintained in each bootstrap step"
            },
            "1.4": {
                "field_name": "categs",
                "field_title": "As pasted CSV text",
                "field_type": "text",
                "field_parent": "categsGroup",
                "field_order": 2,
                "field_is_optional_fg": true,
                "field_description": "Enter the categroization matrix where rowa correspond to samples and columns are category values"
            },
            "1.5": {
                "field_name": "categsFile",
                "field_title": "Categories File",
                "field_type": "obj",
                "field_parent": "categsGroup",
                "field_order": 1,
                "field_is_optional_fg": true,
                "field_is_multi_fg": true,
                "field_is_batch_fg": true,
                "field_constraint": "type",
                "field_constraint_data": "u-file,csv-table"
            },
            "1.6": {
                "field_name": "categsGroup",
                "field_title": "Categorization table",
                "field_type": "list",
                "field_order": 2
            },
            "1.7": {
                "field_name": "checkCategs",
                "field_title": "As pasted CSV text",
                "field_type": "text",
                "field_parent": "checkCategsGroup",
                "field_order": 2,
                "field_is_optional_fg": true,
                "field_description": "Enter the categroization matrix where rowa correspond to samples and columns are category values"
            },
            "1.8": {
                "field_name": "checkCategsFile",
                "field_title": "As file object",
                "field_type": "obj",
                "field_parent": "checkCategsGroup",
