                "field_name": "dataMode",
                "field_title": "Matrix Parsing Mode",
                "field_type": "integer",
                "field_parent": "parsing",
                "field_order": 3,
                "field_default_value": "0",
                "field_constraint": "choice",
                "field_constraint_data": "0///Numerical Values in Table|1///Binary Values match/missmatch first row|2///Individual Unique Values Enumerated|3///Binary values below=0/above=1 threshold"
            },
            "1.15": {
                "field_name": "filterColumns",
                "field_title": "Filter columns (measurements)  by substring or regexp",
                "field_type": "string",
                "field_parent": "filters",
                "field_is_optional_fg": true,
                "field_is_multi_fg": true,
                "field_constraint": "choice+",
                "field_constraint_data": "ERCC-|regex:ENST"
            },
            "1.16": {
                "field_name": "filterRows",
                "field_title": "Filter rows (samples) by substring or regexp",
                "field_type": "string",
                "field_parent": "filters",
                "field_is_optional_fg": true,
                "field_is_multi_fg": true
            },
            "1.17": {
                "field_name": "filters",
                "field_title": "Filters",
                "field_type": "list",
                "field_order": 2
            },
