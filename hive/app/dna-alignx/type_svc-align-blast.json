{
    "type.26": {
        "_id": "type.26",
        "_type": "type",
        "name": "svc-align-blast",
        "title": "Blast Alignment",
        "description": "Blast alignment engine optimized for HIVE performance",
        "parent": {
            "1": "type.90"
        },
        "prefetch": true,
        "fields": {
            "1.3": {
                "field_name": "evalueFilter",
                "field_title": "E-value Filter",
                "field_type": "real",
                "field_default_value": "1e-4",
                "field_is_optional_fg": true,
                "field_description": "Alignments with smaller scores are discarded and not reported. If 'none' is specified: all alignments are reported which satisfy the other criteria."
            },
            "1.4": {
                "field_name": "maxHitsPerRead",
                "field_title": "Max Target Sequences",
                "field_type": "integer",
                "field_default_value": "200",
                "field_constraint": "eval",
                "field_constraint_data": "!(isNaN(\"$_(val)\")) && parseInt(\"$_(val)\")>=0",
                "field_constraint_description": "Give a positive number",
                "field_description": "Number of aligned sequences to keep. Use with report formats that do not have separate definition line and alignment sections such as tabular (all outfmt > 4). Not compatible with num_descriptions or num_alignments."
            },
            "1.5": {
                "field_name": "num_alignments",
                "field_title": "Number of Alignments to Keep ",
                "field_type": "integer",
                "field_default_value": "10",
                "field_constraint": "eval",
                "field_constraint_data": "!(isNaN(\"$_(val)\")) && parseInt(\"$_(val)\")>=0",
                "field_constraint_description": "Give a positive number",
                "field_description": "Show alignments for this number of database sequences."
            },
            "1.6": {
                "field_name": "seedSize",
                "field_title": "Word Size",
                "field_type": "string",
                "field_default_value": "28",
                "field_constraint": "eval",
                "field_constraint_data": "!(isNaN(\"$_(val)\")) && parseInt(\"$_(val)\")>=0",
                "field_constraint_description": "Give a positive number",
                "field_description": "Word size for initial match."
            },
            "1.7": {
                "field_name": "slice",
                "field_title": "slice",
                "field_type": "integer",
                "field_default_value": "4000",
                "field_is_optional_fg": true,
                "field_is_hidden_fg": true,
                "field_constraint": "eval",
                "field_constraint_data": "!(isNaN(\"$_(val)\")) && parseInt(\"$_(val)\")>=1000  && parseInt(\"$_(val)\")<=10000",
                "field_constraint_description": "Give a positive number between 1000 and 10000",
                "field_description": "Number of sequences for each job (for splitting of alignment among nodes)"
            },
            "1.8": {
                "field_name": "splitSize",
                "field_title": "slice",
                "field_type": "integer",
                "field_parent": "splitList",
                "field_default_value": "4000",
                "field_is_optional_fg": true,
                "field_is_hidden_fg": true,
                "field_constraint": "eval",
                "field_constraint_data": "!(isNaN(\"$_(val)\")) && parseInt(\"$_(val)\")>=1000  && parseInt(\"$_(val)\")<=10000",
                "field_constraint_description": "Give a positive number between 1000 and 10000",
                "field_description": "Number of sequences for each job (for splitting of alignment among nodes)"
            },
            "1.11": {
                "field_name": "blastn_task",
                "field_title": "task",
                "field_type": "string",
                "field_order": 12,
                "field_default_value": "megablast",
                "field_constraint": "choice",
                "field_constraint_data": "blastn///blastn (Traditional requiring an exact match of 11 wordsize)|blastn-short///blastn-short (optimized for sequences shorter than 50 bases)|megablast///megablast (used to find very similar sequences|dc-megablast///dc-megablast (Discontiguos megablast used to find more distant sequences)"
            },
            "1.13": {
                "field_name": "splitOnFrontEnd",
                "field_title": "splitOnFrontEnd",
                "field_type": "bool",
                "field_parent": "splitList",
                "field_default_value": "true",
                "field_is_optional_fg": true,
                "field_is_hidden_fg": true
            },
            "1.15": {
                "field_name": "num_descriptions",
                "field_title": "num_descriptions",
                "field_type": "integer",
                "field_description": "-num_descriptions <Integer, >=0>\n   Number of database sequences to show one-line descriptions for\n   Not applicable for outfmt > 4\n   Default = `500'\n    * Incompatible with:  max_target_seqs",
                "field_is_optional_fg": true,
                "field_is_hidden_fg": true
            },
            "1.17": {
                "field_name": "best_hit_score_edge",
                "field_title": "best_hit_score_edge",
                "field_type": "real",
                "field_description": "-best_hit_score_edge <Real, (>0 and <0.5)>\n   Best Hit algorithm score edge value (recommended value: 0.1)\n    * Incompatible with:  culling_limit",
                "field_is_optional_fg": true,
                "field_is_hidden_fg": true
            },
            "1.19": {
                "field_name": "best_hit_overhang",
                "field_title": "best_hit_overhang",
                "field_type": "real",
                "field_description": "-best_hit_overhang <Real, (>0 and <0.5)>\n   Best Hit algorithm overhang value (recommended value: 0.1)\n    * Incompatible with:  culling_limit",
                "field_is_optional_fg": true,
                "field_is_hidden_fg": true
            },
            "1.20": {
                "field_name": "version",
                "field_title": "Version",
                "field_type": "string",
                "field_parent": "system",
                "field_default_value": "2.2.30",
                "field_role": "parameter",
                "field_is_readonly_fg": 2
            },
            "1.21": {
                "field_name": "svc",
                "field_title": "Service ID",
                "field_type": "string",
                "field_parent": "system",
                "field_default_value": "dna-alignx-blast",
                "field_role": "state",
                "field_is_readonly_fg": 2,
                "field_is_hidden_fg": true
            }
        },
        "_perm": [
            {
                "party": "/system/",
                "act": {
                    "browse": true,
                    "read": true,
                    "write": true,
                    "exec": true,
                    "del": true,
                    "admin": true,
                    "share": true,
                    "download": true
                },
                "_infect": {
                    "party": [ "member" ]
                }
            },
            {
                "party": "/everyone/",
                "act": {
                    "browse": true,
                    "read": true
                },
                "_infect": {
                    "party": [ "member" ]
                }
            }
        ]
    }
}
