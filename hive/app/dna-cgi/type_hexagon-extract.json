{
    "type.940": {
        "_id": "type.940",
        "_type": "type",
        "name": "hexagon-extract",
        "title": "Hexagon Data Extraction Tool",
        "description": "Extract Files after Hexagon computation",
        "fields": {
            "1.0": {
                "field_name": "use_type",
                "field_type": "bool",
                "field_default_value": true,
                "field_is_hidden_fg": true
            },
            "1.1": {
                "field_name": "cgi_dstname",
                "field_type": "string",
                "field_default_value": "hexagon_extract_table.csv",
                "field_is_hidden_fg": true
            },
            "1.2": {
                "field_name": "arch",
                "field_type": "bool",
                "field_default_value": true,
                "field_is_hidden_fg": true
            },
            "1.3": {
                "field_name": "objs",
                "field_title": "Hexagon Computation",
                "field_type": "obj",
                "field_order": 1,
                "field_role": "input",
                "field_is_optional_fg": false,
                "field_constraint": "type",
                "field_constraint_data": "svc-align+"
            },
            "1.4": {
                "field_name": "cmd",
                "field_title": "Command",
                "field_type": "string",
                "field_order": 2,
                "field_is_optional_fg": false,
                "field_constraint": "choice",
                "field_constraint_data": "alMatch///Hit Table|alCount///Hit List"
            },
            "1.5": {
                "field_name": "start",
                "field_type": "integer",
                "field_default_value": 0,
                "field_is_hidden_fg": true
            },
            "1.6": {
                "field_name": "cnt",
                "field_type": "integer",
                "field_default_value": 0,
                "field_is_hidden_fg": true
            },
            "1.7": {
                "field_name": "down",
                "field_type": "integer",
                "field_default_value": 1,
                "field_is_hidden_fg": true
            },
            "1.8": {
                "field_name": "info",
                "field_type": "integer",
                "field_default_value": 1,
                "field_is_hidden_fg": true
            },
            "1.9": {
                "field_name": "mySubID",
                "field_title": "Subject id",
                "field_type": "integer",
                "field_is_optional_fg": true
            },
            "1.10": {
                "field_name": "qty",
                "field_title": "qty",
                "field_type": "integer",
                "field_is_optional_fg": true,
                "field_description": "Put -1 if you want all subject ids"
            },
            "1.11": {
                "field_name": "dissect",
                "field_type": "integer",
                "field_default_value": 100000000,
                "field_is_hidden_fg": true
            }
        },
        "parent": {
            "8": "type.331"
        },
        "_perm": [
            {
                "party": "/everyone/",
                "act": {
                    "browse": true,
                    "read": true
                },
                "_infect": {
                    "party": [ "member" ]
                }
            }
        ]
    }
}
