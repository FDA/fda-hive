{
    "291": {
        "_id": "$type.svc-dna-kraken",
        "_type": "type",
        "name": "svc-dna-kraken",
        "title": "Kraken Taxonomic Screening Service",
        "description": "//\nlocation:hive.app.dna.dna-kraken",
        "fields": {
            "1.0": {
                "field_name": "DB",
                "field_title": "Database",
                "field_type": "obj",
                "field_order": 1,
                "field_constraint": "type",
                "field_constraint_data": "special"
            },
            "1.2": {
                "field_name": "input1",
                "field_title": "Input Forward File",
                "field_type": "obj",
                "field_parent": "inputs",
                "field_order": 2,
                "field_constraint": "type",
                "field_constraint_data": "nuc-read"
            },
            "1.3": {
                "field_name": "input2",
                "field_title": "Input Reverse File",
                "field_type": "obj",
                "field_parent": "inputs",
                "field_order": 3,
                "field_constraint": "type",
                "field_constraint_data": "nuc-read",
                "field_is_optional_fg": true
            },
            "1.5": {
                "field_name": "inputs",
                "field_title": "NGS inputs",
                "field_type": "list"
            },
            "1.7": {
                "field_name": "ntSource",
                "field_title": "References Source",
                "field_type": "obj",
                "field_parent": "extract_refs",
                "field_is_optional_fg": true,
                "field_constraint": "type",
                "field_constraint_data": "genome"
            },
            "1.8": {
                "field_name": "threshold_coverage",
                "field_title": "Threshold (expected coverage)",
                "field_type": "integer",
                "field_parent": "extract_refs",
                "field_default_value": "0",
                "field_is_optional_fg": true
            },
            "1.9": {
                "field_name": "threshold_hits",
                "field_title": "Threshold (number of hits)",
                "field_type": "integer",
                "field_parent": "extract_refs",
                "field_default_value": "0",
                "field_is_optional_fg": true
            },
            "1.11": {
                "field_name": "extract_refs",
                "field_title": "Extract references",
                "field_type": "list"
            },
            "1.12": {
                "field_name": "rank_refs",
                "field_title": "Ranks",
                "field_type": "string",
                "field_parent": "extract_refs",
                "field_default_value": "-",
                "field_is_optional_fg": false,
                "field_constraint": "choice",
                "field_constraint_data": "-///Do Not Extract|U///Unclassified|D///Domain|K///Kingdom|P///Phylum|C///Class|O///Order|F///Family|G///Genus|S///Species"
            },
            "1.14": {
                "field_name": "max_per_species",
                "field_title": "Maximum Accession for Each Taxid",
                "field_type": "integer",
                "field_parent": "extract_refs",
                "field_default_value": "20"
            },
            "1.15": {
                "field_name": "top_species",
                "field_title": "How many top species to extract",
                "field_type": "integer",
                "field_parent": "extract_refs",
                "field_default_value": "0"
            }
        },
        "parent": {
            "7": "$type.svc-docker-base"
        },
        "_perm": [
            {
                "party": "/system/",
                "act": {
                    "browse": true,
                    "read": true,
                    "write": true,
                    "exec": true,
                    "del": true,
                    "admin": true,
                    "share": true,
                    "download": true
                },
                "_infect": {
                    "party": [ "member" ]
                }
            }
        ]
    }
}
