{
    "104": {
        "_id": "$type.svc-modular",
        "_type": "type",
        "name": "svc-modular",
        "title": "Modular service process",
        "description": "// Maintains the service for running HIVE Modular service\nlocation: hive.app.system.modular",
        "parent": {
            "1": "$type.svc-sysop-base"
        },
        "fields": {
            "1.1": {
                "field_name": "cmd",
                "field_title": "Command filter",
                "field_type": "string",
                "field_order": 0.1,
                "field_is_optional_fg": true,
                "field_constraint": "choice+",
                "field_constraint_data": "prepare///Prepare|deploy///Deploy"
            },
            "1.2": {
                "field_name": "stopOnErrors",
                "field_title": "Stop On Errors",
                "field_type": "bool",
                "field_order": 0.1,
                "field_default_value": "true"
            },
            "1.3": {
                "field_name": "followDependencies",
                "field_title": "Follow Dependencies",
                "field_type": "bool",
                "field_order": 0.2,
                "field_default_value": "true"
            },
            "1.4": {
                "field_name": "package",
                "field_title": "Package",
                "field_type": "string",
                "field_order": 2,
                "field_is_optional_fg": true,
                "field_is_multi_fg": true,
                "field_constraint": "search+",
                "field_constraint_data": "{fetch:'name',inline:'name',outline:'id,name,version', url:'http://?cmd=objList&type=sys_package%2B&raw=1&mode=csv'}"
            },
            "1.6": {
                "field_name": "credentials",
                "field_title": "Credentials",
                "field_type": "list",
                "field_is_optional_fg": true
            },
            "1.7": {
                "field_name": "login",
                "field_title": "Login",
                "field_type": "string",
                "field_parent": "credentials",
                "field_is_optional_fg": true
            },
            "1.8": {
                "field_name": "pswd",
                "field_title": "Password",
                "field_type": "string",
                "field_parent": "credentials",
                "field_is_optional_fg": true
            },
            "1.9": {
                "field_name": "session",
                "field_title": "SessionID",
                "field_type": "string",
                "field_parent": "credentials",
                "field_is_optional_fg": true
            }
        },
        "_perm": [
            {
                "party": "/system/",
                "act": {
                    "browse": true,
                    "read": true,
                    "write": true,
                    "exec": true,
                    "del": true,
                    "admin": true,
                    "share": true,
                    "download": true
                },
                "_infect": {
                    "party": [ "member" ]
                }
            },
            {
                "party": "/everyone/users/",
                "act": {
                    "browse": true,
                    "read": true,
                    "download": true
                },
                "_infect": {
                    "party": [ "member" ]
                }
            }
        ]
    }
}
