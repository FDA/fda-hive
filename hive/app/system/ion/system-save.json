// _/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/
// _/
// _/ definition of fundamental primitives 
// _/
// _/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/ 

primitives : {  
	bool : {
		_type: "type", 
		
		constraint : {
			choice : {  
				true: 1,
				false : 0
			} 
		}
	},
	
	integer : {
		_type: "type"
	},
	
	string : {
		_type: "type"
	},
	
	datetime : {
		_type: "type",
		_default : '$timenow()'
	},
	
	password : {
		_type: "string" 
	},
	
	email : {
		_type: "string"
 
	},
	
	hiveid : {
		_type: "integer"
		// _default: $newid() this is the dafault behavior set by the ion-birel system
	}
},


// _/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/
// _/
// _/ definition of fundamental types
// _/
// _/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/ 

// define type type by referencing to itself
hc_type = { 
	_type : "type",
	_id : "$newid()",
	_attribute : {
		name : { 
			_type: "string"
		},
		title : { 
			_type: "string" 
		},
	 	description : { 
	 		_type: "string" 
		},
		created : { 
			_type : "datetime",
		
			mandatory : "bool"
		},
		modified : { 
			_type : "datetime" 
		},
		_id : {
			_type: "hiveid"
		}
	},

	name : "hc_type",
	title : "Type type",
	description : "Type for all types"
},

// define system base type	
hc_base = {
	_type : "type",
	_id : "$newid()",
	_attribute : {
		created : { 
			_type : "datetime",
		
			mandatory : "bool"
		},
		modified : { 
			_type : "datetime" 
		},
		_id : {
			_type: "hiveid"
		}
	},	
	
	name : "hc_system_base",
	title : "Base system type",
	description : "Base type for all system types"
},



// define system base type	
hc_system_base = {
	_type : "type",
	_id : "$newid()",
	_inherit : "hc_base",
	
	name : "hc_system_base",
	title : "Base system type",
	description : "Base type for all system types"
},


// define user base type	
hc_user_base = {
	_type : "type",
	_id : "$newid()",
	_inherit : "hc_base",
	
	name : "hc_user_base",
	title : "Base user type",
	description : "Base type for all user visible types"
},
	

