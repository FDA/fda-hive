// define type file
hc_file = {
	_type: "type",
	_id : "$newid()",

	_attribute : { 
		compressed-size : { 
			_type : "integer",
			_write : "once",
			title : "Compressed size"
		},
		ext : { 
			_type : "string", 
			title : "Extension"
	 	}, 		
		md5 : { 
			_type : "string",
			title : "MD5"
		},
		name : { 
			_type : "string" ,
			title : "name"
		},
		orig_name : { 
			_type : "string" , 
			title : "Original filename"
		},
		size : { 
			_type : "integer" ,
		 	title : "Size"
		},
		source : { 
			_type : "string",
			title : "Source"
		}
	},
	
	name : "hc_file",
	title : "File type" ,
	description : "Base type for all file types"
},

// define system file type
hc_system_file = { 
	_type : _type,
	_id : "$newid()",
	_inherit : [ 
		"hc_file", 
		"hc_system_base"
	]
	 	
},

// define user file type
hc_user_file = { 
	_type : _type,
	_id : "$newid()",
	_inherit : [ 
		"hc_file",
		"hc_user_base"
	]
},

