	points: [
			 {
				name:"query"
				tile: " Input Query Strings"
				form: {
					x: 10
					y: eval:obj2.points.query.form.x
					shape: triangle
					cx : 20
					cy : eval:gx 
				}
			 },
			 { 
				 	 name : alignment
					 uid: "$process:alignment"
			 }
	]
		
	
	
}

link: {
	points: [ 
			 {
			start: obj1.query 
			 }
			 ]
}