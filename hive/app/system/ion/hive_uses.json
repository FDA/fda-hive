		{"a":{"source" : "$randstr()","db" : "$randint()","id" : "a$newid()","url" : "$randstr()"},"b":"$randstr()"},
		{"a":{"source" : "$randstr()","db" : "$randint()","id" : "a$newid()","url" : "$randstr()"},"b":"$randstr()"}
	]
} 	


// _dic will use the _type to extract the datatype wihtout _field being given    

"t-cmdline" : {
    "_type" : "cmdline",
    "_dic" : {
        "choice" : [
            "Choose me",
            "No, choose me",
            {"value" : 13, "title" : " I am better"}
        ]
    }, 
    "_rdonly" : 2
}
   
