// FULL DEFINITION

"_dic" : { 
		"_field": { } ,  // list of fields from this data source
		"_type" : "existing_type",  
		
		"choice" : [ // strictly constrained list of elements 
	 		"element1" , 
	 		"element2" , 
	 		{ 
	 			"title" : "element3 title here",
	 			"value" : "element3 value here" 
	 		}
		 ],
		 
		 "collect" : "expression to collect for a value from sele cted elements of dictionary: value by default",
		 "url" : "http:/domain.com/page" ,
		 "mode" : "json|csv"
	},
	
	
/
// Field is defined - use that 
"aa1" : {
	"a" : { 
    	"_type": "ref"
 	}, 
 	"b": {
    	"_type" : "static"
	},
    "_dic" : {
     	"_field" : { 
             "a" : { 
                "_type": "ref"
             }, 
             "b": {
                "_type" : "static"
             } 
        }, 
		choice : [                   
    	    {"a":{"source" : "$randstr()","db" : "$randint()","id" : "a$newid()","url" : "$randstr()"},"b":"$randstr()"},
			{"a":{"source" : "$randstr()","db" : "$randint()","id" : "a$newid()","url" : "$randstr()"},"b":"$randstr()"}
		]
	},
	"_title" : "RORORORORO"
},
	
